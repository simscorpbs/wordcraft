+P['Page width']=('Largura da página','gramatica','É um botão do diálogo de Zoom.')
+P['Words only']=('Somente palavras','gramatica','É uma opção do menu de sublinhado.')
+P['Text to display:']=('Texto a ser exibido:','gramatica','É um rótulo do diálogo de hiperlink.')
+P['Normal speed']=('Velocidade normal','gramatica','É uma dica do controle de leitura em voz alta.')
+P['Engrave']=('Gravado','termo-word','É o nome do efeito de fonte no Word pt-BR.')
+P['Legal style numbering']=('Numeração no estilo legal','termo-word','É o termo indicado para a opção de listas no Word pt-BR.')
+
+# O mesmo estilo de borda aparece com duas grafias no inglês.
+P['Dot dash']=('Ponto-traço','consistencia','É o mesmo estilo de borda traduzido como Dot-dash em outra entrada.')
+P['Dot-dash']=('Ponto-traço','consistencia','É o mesmo estilo de borda traduzido como Dot dash em outra entrada.')
+
+# A capitalização do Word deixa artigos, preposições e conjunções em minúsculas.
+_lower = {'a','à','ao','as','às','até','com','como','da','das','de','do','dos','e','em','entre','na','nas','no','nos','o','os','ou','para','por','sem','sob','um','uma','uns','umas'}
+def resource_case(s):
+    parts=re.split(r'(\s+|\\n|/|: )', s)
+    first=True
+    for i,x in enumerate(parts):
+        if not x or x.isspace() or x in {'\\n','/'} or x == ': ': continue
+        bare=x.strip('()[]….,')
+        if bare.lower() in _lower and not first:
+            parts[i]=x.lower()
+        first=False
+    return ''.join(parts)
+for k,(v,c,r) in list(P.items()):
+    if c in {'maiuscula','termo-word'}:
+        P[k]=(resource_case(v),c,r)
+
+def main():
+    out=[]
+    for line,ctx,en,cur in csv.reader(open('trecho.tsv',encoding='utf-8'),delimiter='\t'):
+        if en in P and P[en][0] != cur:
+            pt,cat,reason=P[en]
+            out.append([line,ctx,en,cur,pt,cat,reason])
+    with open('propostas.tsv','r',encoding='utf-8') as f: new=list(csv.reader(f,delimiter='\t'))[1:]
+    with open('propostas.tsv','w',encoding='utf-8',newline='') as f:
+        for row in [['linha','contexto','inglês','tradução atual','proposta','categoria','motivo'],*out,*new]:
+            f.write('\t'.join(row)+'\n')
+    print('existing',len(out),'new',len(new),'total',len(out)+len(new))
+if __name__=='__main__': main()
