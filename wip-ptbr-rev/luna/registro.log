  54: def title_pt(s):
  55:     # Galeria, estilos e comandos usam a capitalizacao de nomes de recurso do Word.
  56:     out=[]
  57:     for i,t in enumerate(re.split(r'(\s+|\\n|/|: )',s)):
  58:         if not t or t.isspace() or t in {'\\n','/',' :'} or t == ': ': out.append(t); continue
  59:         bare=t.strip('()[]….,')
  60:         if i and bare.lower() in LOWER: out.append(t.lower()); continue
  61:         if t and t[0].isalpha(): out.append(t[0].upper()+t[1:])
  62:         else: out.append(t)
  63:     return ''.join(out)
  64: 
  65: def main():
  66:     rows=[]
  67:     for ctx,en in csv.reader(open('faltam.tsv',encoding='utf-8'),delimiter='\t'):
  68:         pt=translate(ctx,en)
  69:         if en not in SENTENCE and len(en.split()) < 9:
  70:             pt=title_pt(pt)
  71:         rows.append(['',ctx,en,'',pt,'nova','Texto novo da interface. A tradução foi escolhida conforme o contexto do código.'])
  72:     with open('propostas.tsv','w',encoding='utf-8',newline='') as f:
  73:         for row in [['linha','contexto','inglês','tradução atual','proposta','categoria','motivo'],*rows]:
  74:             f.write('\t'.join(row)+'\n')
  75:     print('novas',len(rows))
  76:     for r in rows:
  77:         if r[2] == r[4]: print('NAO TRADUZIDO',r[2])
  78: if __name__=='__main__': main()

