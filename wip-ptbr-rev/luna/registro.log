}
# Build lookup for current catalog entries from trecho.tsv.
catrows=list(csv.reader(open('trecho.tsv',encoding='utf-8-sig'),delimiter='\\t'))
by_en={r[2]:r for r in catrows}
existing={(r[1],r[2]) for r in data}
added=[]
for en,(prop,cat,reason) in multiline.items():
    if en not in by_en:
        raise SystemExit(f'multiline not in trecho: {en"'!r}'"')
    line,ctx,eng,cur=by_en[en]
    if cur==prop:
        continue
    key=(ctx,en)
    if key in existing:
        for r in data:
            if (r[1],r[2])==key:
                r[4]=prop; r[5]=cat; r[6]=reason
                break
    else:
        added.append([line,ctx,en,cur,prop,cat,reason])
        existing.add(key)
# Sort existing rows by source line, then leave new entries in their original order.
allrows=data+added
allrows.sort(key=lambda r: (0,int(r[0])) if r[0].isdigit() else (1, r[2]))
with path.open('w',encoding='utf-8',newline='') as f:
    for r in [header]+allrows:
        f.write('\\t'.join(r)+'\\n')
print('added',len(added),'total data',len(allrows))
for r in added: print(r[0],r[2],'=>',r[4])
