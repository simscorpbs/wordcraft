+def title_pt(s):
+    # Galeria, estilos e comandos usam a capitalizacao de nomes de recurso do Word.
+    out=[]
+    for i,t in enumerate(re.split(r'(\s+|\\n|/|: )',s)):
+        if not t or t.isspace() or t in {'\\n','/',' :'} or t == ': ': out.append(t); continue
+        bare=t.strip('()[]….,')
+        if i and bare.lower() in LOWER: out.append(t.lower()); continue
+        if t and t[0].isalpha(): out.append(t[0].upper()+t[1:])
+        else: out.append(t)
+    return ''.join(out)
+
+def main():
+    rows=[]
+    for ctx,en in csv.reader(open('faltam.tsv',encoding='utf-8'),delimiter='\t'):
+        pt=translate(ctx,en)
+        if en not in SENTENCE and len(en.split()) < 9:
+            pt=title_pt(pt)
+        rows.append(['',ctx,en,'',pt,'nova','Texto novo da interface. A tradução foi escolhida conforme o contexto do código.'])
+    with open('propostas.tsv','w',encoding='utf-8',newline='') as f:
+        for row in [['linha','contexto','inglês','tradução atual','proposta','categoria','motivo'],*rows]:
+            f.write('\t'.join(row)+'\n')
+    print('novas',len(rows))
+    for r in rows:
+        if r[2] == r[4]: print('NAO TRADUZIDO',r[2])
+if __name__=='__main__': main()

