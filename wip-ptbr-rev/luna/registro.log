# Read input rows and emit only actual changes plus every missing key.
existing=[]
for line,ctx,en,cur in csv.reader(open('trecho.tsv',encoding='utf-8'),delimiter='\\t'):
    key=(ctx,en)
    if key in E:
        pt,cat,motivo=E[key]
        if pt "'!= cur:
            existing.append((line,ctx,en,cur,pt,cat,motivo))
missing=[]
for ctx,en in csv.reader(open('"'faltam.tsv',encoding='utf-8'),delimiter='\\t'):
    key=(ctx,en)
    if key not in N:
        print('MISSING',repr(key))
        continue
    missing.append(('',ctx,en,'',N[key],'nova','Texto novo da interface; a tradução foi escolhida conforme o contexto do código.'))
rows=existing+missing
with open('propostas.tsv','w',encoding='utf-8',newline='') as f:
    w=csv.writer(f,delimiter='\\t',lineterminator='\\n')
    w.writerow(['linha','contexto','inglês','tradução atual','proposta','categoria','motivo'])
    w.writerows(rows)
print('existing',len(existing),'missing',len(missing),'total',len(rows))
