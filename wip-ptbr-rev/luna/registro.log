+TITLE['All - Linear']='Todas - Linear'
+TITLE['All - Professional']='Todas - Profissional'
+TITLE['Text to display:']='Texto a ser exibido:'
+TITLE['Type a command, e.g. "insert table"']='Digite um comando, por exemplo "insert table"'
