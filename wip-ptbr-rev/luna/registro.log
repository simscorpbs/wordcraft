+import csv, re
+
+P = {}
+def p(en, pt, cat='maiuscula', reason='Nome de recurso conforme a interface do Word pt-BR.'):
+    P[en] = (pt, cat, reason)
+
+# Termos oficiais e erros de sentido que nao dependem apenas de maiusculas.
+for en,pt,cat,reason in [
+ ('Home','Página Inicial','termo-word','É o nome da aba correspondente ao Home do Word pt-BR.'),
+ ('Quick Access Toolbar','Barra de Ferramentas de Acesso Rápido','termo-word','É o nome oficial da barra no Word pt-BR.'),
+ ('Customize Quick Access Toolbar','Personalizar Barra de Ferramentas de Acesso Rápido','termo-word','O comando usa o nome oficial da barra.'),
+ ('Manage Sources','Gerenciar Fontes Bibliográficas','termo-word','O comando de Referências gerencia fontes bibliográficas.'),
+ ('AutoText','Texto Automático','termo-word','O recurso do Word pt-BR chama-se Texto Automático.'),
+ ('All Markup','Toda a Marcação','termo-word','Display for Review usa a opção oficial Toda a Marcação.'),
+ ('Table Layout','Layout da Tabela','termo-word','É a aba contextual da tabela no Word pt-BR.'),
+ ('WordArt','WordArt','termo-word','O nome do recurso é WordArt no Word pt-BR.'),
+ ('Proofing','Revisor de Texto','termo-word','É o nome da categoria de opções conforme o vocabulário do Word pt-BR.'),
+ ('Small Caps','Versalete','termo-word','O efeito tipográfico do Word é Versalete no singular.'),
+ ('Small caps','Versalete','termo-word','O efeito tipográfico do Word é Versalete no singular.'),
+ ('Banded Columns','Colunas em Tiras','termo-word','A opção de estilo de tabela usa Tiras no Word pt-BR.'),
+ ('Banded Rows','Linhas em Tiras','termo-word','A opção de estilo de tabela usa Tiras no Word pt-BR.'),
+ ('Legal style numbering','Numeração no estilo legal','termo-word','É o termo indicado para a opção de listas no Word pt-BR.'),
+ ('Fill','Preenchimento','termo-word','É o preenchimento do diálogo de bordas e sombreamento.'),
+ ('Inside:','Internas:','gramatica','O rótulo se refere às bordas internas, no plural feminino.'),
+ ('Outside:','Externas:','gramatica','O rótulo se refere às bordas externas, no plural feminino.'),
+ ('Font Dialog','Caixa de diálogo Fonte','termo-word','O nome do comando identifica a caixa de diálogo Fonte.'),
+ ('Engrave','Gravura','sentido','É um efeito de texto. Gravura nomeia o efeito melhor que Gravado.'),
+ ('Normal Style','Normal','termo-word','O estilo interno padrão do Word pt-BR aparece como Normal.'),
+ ('Table of Figures','Índice de Ilustrações','termo-word','O Word pt-BR usa Índice de Ilustrações para esse recurso.'),
+ ('Insert Table of Figures','Inserir Índice de Ilustrações','termo-word','O comando segue o nome oficial Índice de Ilustrações.'),
+ ('All Caps','Todas em Maiúsculas','termo-word','É uma opção de efeito da Fonte no Word pt-BR.'),
+ ('All caps','Todas em Maiúsculas','maiuscula','A opção de efeito mantém o mesmo nome do recurso.'),
+ ('Proofing Issues','Problemas do Revisor de Texto','termo-word','A área de revisão usa o termo Revisor de Texto.'),
+ ('Read Aloud','Ler em Voz Alta','maiuscula','É o comando da aba Revisão.'),
+ ('Read Mode','Modo de Leitura','maiuscula','É um modo da aba Exibir.'),
+ ('Track Changes','Controlar Alterações','maiuscula','É o nome oficial do comando da aba Revisão.'),
+ ('Track Changes Options','Opções de Controle de Alterações','maiuscula','É o nome do grupo de opções da Revisão.'),
+ ('Track Changes: On','Controlar Alterações: Ativado','maiuscula','É o estado exibido do comando Controlar Alterações.'),
+ ('Show Markup','Mostrar Marcação','maiuscula','É um comando da área de controle de alterações.'),
+ ('Display for Review','Exibir para Revisão','maiuscula','É o menu de exibição das alterações.'),
+ ('Reviewing Pane','Painel de Revisão','maiuscula','É o painel da aba Revisão.'),
+ ('Finish & Merge','Concluir e Mesclar','maiuscula','É o comando de Correspondências.'),
+ ('Finish &\\nMerge','Concluir e\\nMesclar','maiuscula','É a versão quebrada do comando de Correspondências.'),
+ ('Format Painter','Pincel de Formatação','maiuscula','É o nome oficial do comando da Área de Transferência.'),
+ ('Cover Page','Folha de Rosto','termo-word','O Word pt-BR chama Cover Page de Folha de Rosto.'),
+ ('Change Case','Alterar Maiúsculas e Minúsculas','termo-word','O Word pt-BR usa Maiúsculas e Minúsculas.'),
+ ('Text Highlight Color','Cor do Realce do Texto','termo-word','É o nome usado pelo Word pt-BR para o realce.'),
+ ('Screenshot','Instantâneo','termo-word','O Word pt-BR usa Instantâneo para Screenshot.'),
+ ('Drop Cap','Letra Capitular','termo-word','O Word pt-BR chama Drop Cap de Letra Capitular.'),
+ ('Wrap Text','Quebra Automática de Texto','termo-word','O Word pt-BR usa Quebra Automática de Texto.'),
+ ('Synchronous Scrolling','Rolagem Sincronizada','termo-word','É o nome do recurso da exibição Lado a Lado.'),
+ ('Page Setup','Configurar Página','termo-word','É o nome do comando de configuração da página.'),
+ ('Web Layout','Layout da Web','termo-word','É um modo de exibição do Word pt-BR.'),
+ ('Print Layout','Layout de Impressão','maiuscula','É um modo de exibição do Word.'),
+ ('Normal speed','Velocidade Normal','maiuscula','É uma opção do controle do leitor.'),
+ ('Type a command, e.g. "insert table"','Digite um comando, por exemplo "inserir tabela"','gramatica','A frase da dica fica em português e o exemplo acompanha a interface.'),
+ ('No templates match your search.','Nenhum modelo corresponde à sua pesquisa.','gramatica','A frase fica natural em português brasileiro.'),
+ ('Rich Text Format (*.rtf)','Formato Rich Text (*.rtf)','ingles','Rich Text é o nome do formato e segue o padrão do Word.'),
+ ('MIT OR Apache-2.0. Copyright (c) 2026 ArtCraft Team and the WordCraft contributors.','MIT ou Apache-2.0. Direitos autorais (c) 2026 ArtCraft Team e colaboradores do WordCraft.','ingles','O aviso de licença é texto visível e a parte comum deve estar em português.'),
+ ('Update Table','Atualizar Sumário','maiuscula','Neste trecho o comando atualiza o sumário.'),
+ ('AutoSave writes your changes to the file a moment after you stop typing.','O Salvamento Automático grava suas alterações no arquivo pouco depois que você para de digitar.','gramatica','A mensagem usa o nome oficial do recurso.'),
+ ('AutoSave saves every change to the file (needs a saved document)','O Salvamento Automático grava cada alteração no arquivo. É necessário que o documento esteja salvo.','gramatica','A mensagem separa a condição do efeito.'),
+ ('AutoSave isn\'t available in the browser: it can\'t write to your files. Save downloads a copy.','O Salvamento Automático não está disponível no navegador porque não pode gravar nos arquivos. Salvar baixa uma cópia.','gramatica','A mensagem evita a construção literal e mantém a ação do botão.'),
+ ('AutoSave only keeps .docx, .odt and .rtf files; {name} can\'t keep all formatting. Save as .docx to turn on AutoSave.','O Salvamento Automático mantém apenas arquivos .docx, .odt e .rtf. {name} não preserva toda a formatação. Salve como .docx para ativá-lo.','gramatica','A mensagem separa as condições e mantém o placeholder.'),
+ ('Automatic follows your system\'s language. Menus and commands change; your documents don\'t.','O modo Automático segue o idioma do sistema. Os menus e comandos mudam. Os documentos não mudam.','gramatica','A redação corrige a concordância da mensagem.'),
+ ('No words yet. Add to Dictionary on a misspelled word puts it here.','Ainda não há palavras. Use Adicionar ao dicionário em uma palavra com erro para incluí-la aqui.','gramatica','A frase explica como o botão preenche a lista.'),
