                    para_check(ui, &mut opts[0], tl!("Mirror indents"), "mirrorIndents", mixed);
                    ui.label(egui::RichText::new(tl!("Spacing")).font(semibold(12.5)));
                    egui::Grid::new("sp").num_columns(4).show(ui, |ui| {
                        ui.label(tl!("Before:"));
