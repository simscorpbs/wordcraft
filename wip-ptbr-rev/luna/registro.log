    simple = {'Grid Table 1 Light':'Tabela de Grade 1 Clara','Grid Table 4 â€“ Blue':'Tabela de Grade 4 â€“ Azul','Grid Table 4 â€“ Green':'Tabela de Grade 4 â€“ Verde','Grid Table 4 â€“ Orange':'Tabela de Grade 4 â€“ Laranja','Grid Table 4 â€“ Purple':'Tabela de Grade 4 â€“ Roxa','List Table 3 â€“ Blue':'Tabela de Lista 3 â€“ Azul','List Table 3 â€“ Green':'Tabela de Lista 3 â€“ Verde','List Table 3 â€“ Orange':'Tabela de Lista 3 â€“ Laranja','List Table 3 â€“ Purple':'Tabela de Lista 3 â€“ Roxa','Change to Level 1':'Alterar para o NÃ­vel 1','Change to Level 2':'Alterar para o NÃ­vel 2','Change to Level 3':'Alterar para o NÃ­vel 3','Change to Level 4':'Alterar para o NÃ­vel 4','Change to Level 5':'Alterar para o NÃ­vel 5','Change to Level 6':'Alterar para o NÃ­vel 6','Change to Level 7':'Alterar para o NÃ­vel 7','Change to Level 8':'Alterar para o NÃ­vel 8','Change to Level 9':'Alterar para o NÃ­vel 9'}
    if en in simple: return simple[en]
