497:/// Every structure template.
498:pub fn templates() -> impl Iterator<Item = &'static Template> {
499:    STRUCTURES.iter().flat_map(|g| g.sections.iter().flat_map(|(_, ts)| ts.iter()))
500:}
501:
502:pub fn template(id: &str) -> Option<&'static Template> {
503:    templates().find(|t| t.id == id)
504:}
