767:fn turkish_covers_the_entire_existing_interface_catalog_and_preserves_templates() {
768:    use std::collections::HashSet;
769:    let keys = |source| parse_entries(source).0.into_iter().map(|e| e.source).collect::<HashSet<_>>();
770:    // Full parity with the Russian catalog: covers all UI strings, styles, math gallery, and presets.
771:    assert_eq!(keys(lang("tr").0.source), keys(lang("ru").0.source));
772:    assert!(keys(lang("es").0.source).is_subset(&keys(lang("tr").0.source)));
773:    assert!(keys(lang("zh-hans").0.source).is_subset(&keys(lang("tr").0.source)));
774:    let tr = lang("tr");
775:    for (source, expected) in [
776:        ("Home", "Giriş"),
777:        ("Font", "Yazı Tipi"),
778:        ("Review", "İncele"),
779:        ("Italic", "İtalik"),
780:        ("Table of Contents", "İçindekiler Tablosu"),
781:        ("Track Changes", "Değişiklikleri İzle"),
782:        ("Save", "Kaydet"),
783:        ("UPPERCASE", "BÜYÜK HARF"),
784:        ("lowercase", "küçük harf"),
785:        ("Square Root", "Karekök"),
786:        ("Euler's identity", "Euler Özdeşliği"),
787:        ("Default Paragraph Font", "Varsayılan Paragraf Yazı Tipi"),
788:        ("CONFIDENTIAL", "GİZLİ"),
789:        ("WordCraft", "WordCraft"),
790:        ("unknown future label", "unknown future label"),
791:    ] {
792:        assert_eq!(super::tr(tr, source), expected);
793:    }
794:    assert_eq!(fmt(super::tr(tr, "Exported {path}"), &[("path", "taslak-{words}.docx")]), "Dışa aktarıldı: taslak-{words}.docx");
795:    assert_eq!(fmt(super::tr(tr, "Page {page} of {pages}"), &[("page", "3"), ("pages", "9")]), "Sayfa 3 / 9");
796:    // The Font dialog uppercases its preview sample for All Caps, so the sample has no lowercase i.
797:    assert_eq!(super::tr(tr, "AaBbYyZz").to_uppercase(), "AABBYYZZ ĞĞİIŞŞ");
798:    // Turkish count nouns remain singular for both one and other, including zero and large counts.
799:    for count in [0, 1, 2, 5, 11, 21, 100, 1000] {
800:        let words = count.to_string();
801:        assert_eq!(fmt(super::tr(tr, "{words} words"), &[("words", &words)]), format!("{count} sözcük"));
802:        assert_eq!(fmt(super::tr(tr, "{selected} of {words} words"), &[("selected", "1"), ("words", &words)]), format!("{count} sözcükten 1 seçili"));
803:    }
804:    set_current(tr);
805:    assert_eq!(location("Home › Font"), "Giriş › Yazı Tipi");
806:    assert_eq!(prefixed("Undo", "Italic"), "Geri Al: İtalik");
807:    set_current(Lang::EN);
808:    assert_eq!(super::tr(Lang::EN, "Italic"), "Italic");
809:}
