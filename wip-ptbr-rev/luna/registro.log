406: /// A style's name as the interface shows it: built-in styles (`Normal`, `Heading 2`, `TOC 3`) in
407: /// the current language, styles the author made exactly as named. Display only: the document,
408: /// commands and saved files keep the English name.
409: pub fn style_name(style: &wordcraft_doc::Style) -> String {
410:     if style.builtin { builtin_style_name(&style.name) } else { style.name.clone() }
