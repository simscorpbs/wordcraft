1007:    assert_eq!(fmt(tr(pl, "Page {page} of {pages}"), &[("page", "3"), ("pages", "9")]), "Strona 3 z 9");
1008:    // Count-neutral wording reads grammatically for every Polish number form (1, 2–4, 5+, 12–14, 22).
