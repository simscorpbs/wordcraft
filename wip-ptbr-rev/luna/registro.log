604 #[test]
605 fn built_in_style_names_are_translated_for_display_and_user_styles_are_not() {
606     let sheet = wordcraft_doc::StyleSheet::builtin();
607     let name = |id: &str| style_name(sheet.get(id).unwrap());
608     set_current(lang("ru"));
609     assert_eq!(name("Normal"), "Обычный");
610     assert_eq!(name("Title"), "Заголовок");
611     assert_eq!(name("Heading1"), "Заголовок 1");
612     // Numbered families beyond the catalog's explicit entries go through one template.
613     assert_eq!(name("Heading7"), "Заголовок 7");
614     assert_eq!(name("TOC9"), "Оглавление 9");
615     // A style the author made keeps its name, even when it matches a built-in one.
616     let mine = wordcraft_doc::Style { name: "Normal".into(), builtin: false, ..Default::default() };
617     assert_eq!(style_name(&mine), "Normal");
618     // A built-in name without a translation stays English.
619     assert_eq!(builtin_style_name("Some Future Style"), "Some Future Style");
620     assert_eq!(builtin_style_name("Heading x"), "Heading x");
621     // Every built-in paragraph and character style shows in Russian. Table styles (`Grid Table 4 –
622     // Blue`) appear only as tooltips under Table Design and stay English for now.
623     let untranslated: Vec<&str> = sheet
624         .styles
625         .iter()
626         .filter(|s| s.kind != wordcraft_doc::StyleKind::Table && style_name(s) == s.name && s.name.chars().any(char::is_alphabetic))
627         .map(|s| s.name.as_str())
628         .collect();
629     assert!(untranslated.is_empty(), "built-in styles without a Russian name: {untranslated:?}");
630     set_current(Lang::EN);
631     assert_eq!(name("Heading7"), "Heading 7");
632     // The document itself never changes.
633     assert_eq!(sheet.get("Normal").unwrap().name, "Normal");
634 }
