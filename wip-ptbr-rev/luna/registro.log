import csv
from pathlib import Path

path=Path('propostas.tsv')
rows=list(csv.reader(path.open(encoding='utf-8-sig'),delimiter='\\t'))
header=rows[0]
data=rows[1:]
# Correções pontuais indicadas pela leitura do código e pela preservação de símbolos matemáticos.
