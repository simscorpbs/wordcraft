+    simple = {'Grid Table 1 Light':'Tabela de Grade 1 Clara','Grid Table 4 – Blue':'Tabela de Grade 4 – Azul','Grid Table 4 – Green':'Tabela de Grade 4 – Verde','Grid Table 4 – Orange':'Tabela de Grade 4 – Laranja','Grid Table 4 – Purple':'Tabela de Grade 4 – Roxa','List Table 3 – Blue':'Tabela de Lista 3 – Azul','List Table 3 – Green':'Tabela de Lista 3 – Verde','List Table 3 – Orange':'Tabela de Lista 3 – Laranja','List Table 3 – Purple':'Tabela de Lista 3 – Roxa','Change to Level 1':'Alterar para o Nível 1','Change to Level 2':'Alterar para o Nível 2','Change to Level 3':'Alterar para o Nível 3','Change to Level 4':'Alterar para o Nível 4','Change to Level 5':'Alterar para o Nível 5','Change to Level 6':'Alterar para o Nível 6','Change to Level 7':'Alterar para o Nível 7','Change to Level 8':'Alterar para o Nível 8','Change to Level 9':'Alterar para o Nível 9'}
+    if en in simple: return simple[en]
+    return en
+
+LOWER = {'a','à','ao','aos','as','às','até','com','como','da','das','de','do','dos','e','em','entre','na','nas','no','nos','o','os','ou','para','por','sem','sobre','um','uma','uns','umas'}
+SENTENCE = {
+    'Body text in a short paragraph to show spacing.','Capitalize the first word of a sentence','Convert between built-up and linear form','Find “{text}” in the document',
+    'A xor B','x bar','Good afternoon','Good evening','Good morning','Normal speed','Continue without restoring','Top of the Document',
+    'Justification of a display equation','Number the equation; the number sits at the right margin (or type # then the number)',
+    'Remove the space before the punctuation','Show the equation in the line of text','Show the equation on a line of its own',
+    'The spelling and grammar check is complete.','This document has no bookmarks.','Type a page number, or +2 / -1.',
+    'Type equations in LaTeX','Type equations in the linear format (UnicodeMath)','Type normal (non-math) text in the equation',
+    'Use "a" before a consonant sound','Use "an" before a vowel sound','Wait for the print job to finish submitting before closing.',
+    'Wildcards (regex)','Crop on the page works on unturned pictures: set Rotation to 0° first, or use the crop boxes',
+    'Couldn\'t save {name}, so it is still open and nothing was lost: {error}','Discard the recovery copy of {name}?',
+    'Local recovery is unavailable or still loading.','No recovery copies.','Nothing of this type in the document.',
+    'Recovery is disabled while this document has a password.','Restore opens an unsaved copy. Your original file stays unchanged.',
+    'Select a place in this document:','This cannot be undone. Your original file stays unchanged.','Type a command, e.g. \\"insert table\\"',
+    'select a picture first','{paper}   {width} × {height}'
+}
+def title_pt(s):
+    # Galeria, estilos e comandos usam a capitalizacao de nomes de recurso do Word.
+    out=[]
+    for i,t in enumerate(re.split(r'(\s+|\\n|/|: )',s)):
+        if not t or t.isspace() or t in {'\\n','/',' :'} or t == ': ': out.append(t); continue
+        bare=t.strip('()[]….,')
+        if i and bare.lower() in LOWER: out.append(t.lower()); continue
+        if t and t[0].isalpha(): out.append(t[0].upper()+t[1:])
+        else: out.append(t)
+    return ''.join(out)
+
+def main():
+    rows=[]
+    for ctx,en in csv.reader(open('faltam.tsv',encoding='utf-8'),delimiter='\t'):
+        pt=translate(ctx,en)
+        if en not in SENTENCE and len(en.split()) < 9:
+            pt=title_pt(pt)
+        rows.append(['',ctx,en,'',pt,'nova','Texto novo da interface. A tradução foi escolhida conforme o contexto do código.'])
+    with open('propostas.tsv','w',encoding='utf-8',newline='') as f:
+        for row in [['linha','contexto','inglês','tradução atual','proposta','categoria','motivo'],*rows]:
+            f.write('\t'.join(row)+'\n')
+    print('novas',len(rows))
+    for r in rows:
+        if r[2] == r[4]: print('NAO TRADUZIDO',r[2])
+if __name__=='__main__': main()

