541:
542:    fn has_leftover(a: &[MNode]) -> bool {
543:        a.iter().any(|n| match n {
544:            MNode::Run(r) => r.text.contains('â¬š') || r.text.contains('â–’') || r.text.contains('â”¬') || r.text.contains('â”´'),
545:            other => {
546:                (0..wordcraft_doc::math_edit::child_count(other)).any(|c| wordcraft_doc::math_edit::child(other, c).is_some_and(|x| has_leftover(x)))
547:            }
548:        })
549:    }
