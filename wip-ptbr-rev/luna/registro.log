1: //! The Equation tab's galleries: structure templates (fractions, scripts, radicals, integrals,
2: //! large operators, brackets, functions, accents, limits and logs, operators, matrices), symbol
3: //! sets and ready-made equations. Every template is linear-format text (`⬚` = empty slot) that
4: //! [`wordcraft_doc::math::parse_linear`] builds into structures.
5: 
6: use wordcraft_doc::math::{Arg, LimLoc, parse_linear};
7: 
8: /// One template.
9: #[derive(Clone, Copy, Debug)]
10: pub struct Template {
11:     pub id: &'static str,
12:     pub label: &'static str,
13:     /// Linear format; `⬚` marks an empty argument.
14:     pub linear: &'static str,
15:     /// Limit placement for n-ary operators (`None`: the operator's default).
16:     pub limits: Option<LimLoc>,
17: }
18: 
19: const fn t(id: &'static str, label: &'static str, linear: &'static str) -> Template {
20:     Template { id, label, linear, limits: None }
21: }
22: const fn stacked(id: &'static str, label: &'static str, linear: &'static str) -> Template {
23:     Template { id, label, linear, limits: Some(LimLoc::UndOvr) }
24: }
25: const fn beside(id: &'static str, label: &'static str, linear: &'static str) -> Template {
26:     Template { id, label, linear, limits: Some(LimLoc::SubSup) }
27: }
28: 
29: impl Template {
30:     /// The template as nodes.
31:     pub fn nodes(&self) -> Arg {
32:         let mut n = parse_linear(self.linear);
33:         if self.limits.is_some() {
34:             wordcraft_doc::math_edit::set_limits(&mut n, self.limits);
35:         }
36:         n
37:     }
38: }
