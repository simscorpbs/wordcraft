+import csv, re
+
+def translate(ctx, en):
+    if en == 'All - Linear': return 'Todas - Linear'
+    if en == 'All - Professional': return 'Todas - Profissional'
+    if en == 'Type a command, e.g. \\"insert table\\"': return 'Digite um comando, por exemplo \\"insert table\\"'
+    # Regras produtivas da galeria de equacoes e dos modelos do Word.
+    m = re.fullmatch(r'([0-9]+×[0-9]+) Empty Matrix', en)
+    if m: return f'Matriz vazia {m.group(1)}'
+    m = re.fullmatch(r'([0-9]+×[0-9]+) Identity Matrix(?: \(sparse\))?', en)
+    if m: return f'Matriz de identidade {m.group(1)}' + (' (esparsa)' if '(sparse)' in en else '')
+    m = re.fullmatch(r'([0-9]+×[0-9]+) Matrix in (Parentheses|Brackets|Double Bars)', en)
+    if m: return f'Matriz {m.group(1)} ' + {'Parentheses':'entre parênteses','Brackets':'entre colchetes','Double Bars':'entre barras duplas'}[m.group(2)]
+    if en == '2×2 Determinant': return 'Determinante 2×2'
+    m = re.fullmatch(r'(n×n) (Identity )?Matrix', en)
+    if m: return ('Matriz de identidade ' if m.group(2) else 'Matriz ') + m.group(1)
+    if ctx == 'preview' and en == 'Title': return 'Título'
+    if ctx == 'template' and en == 'Letter': return 'Carta'
+    irregular = {
+      'A xor B':'A ou exclusivo B','APA':'APA','ASAP':'O quanto antes','AaBbCcDd':'AaBbCcDd','Absolute value cases':'Casos de valor absoluto','Accents':'Acentos','Acute':'Acento agudo','All - Linear':'Tudo - Linear','All - Professional':'Tudo - Profissional','Angle Brackets':'Parênteses angulares','Angle Brackets with Separator':'Parênteses angulares com separador','Angle Brackets with Two Separators':'Parênteses angulares com dois separadores','Annotation Reference':'Referência de anotação','Annotation Subject':'Assunto da anotação','Annotation Text':'Texto da anotação','B4 (JIS)   10.12" × 14.33"':'B4 (JIS)   10,12" × 14,33"','B5 (JIS)   7.17" × 10.12"':'B5 (JIS)   7,17" × 10,12"','Baseline Dots':'Pontos de base','Basic Math':'Matemática básica','Bayes\' rule':'Regra de Bayes','Binomial Coefficient':'Coeficiente binomial','Binomial Coefficient (angle)':'Coeficiente binomial (angular)','Binomial Coefficient with Angle Brackets':'Coeficiente binomial entre parênteses angulares','Binomial expansion of (x+a)ⁿ':'Expansão binomial de (x+a)ⁿ','Body text in a short paragraph to show spacing.':'Texto do corpo em um parágrafo curto para mostrar o espaçamento.','Book Title':'Título de livro','Boxed Formula':'Fórmula em caixa','Boxed Formula (example)':'Fórmula em caixa (exemplo)','Boxed Formulas':'Fórmulas em caixa','Braces':'Chaves','Braces with Separator':'Chaves com separador','Brackets':'Colchetes','Brackets with Separators':'Colchetes com separadores','Breve':'Breve','CONFIDENTIAL':'CONFIDENCIAL','Capitalize the first word of a sentence':'Colocar em maiúscula a primeira palavra de uma frase','Cases (Three Conditions)':'Casos (três condições)','Cases (Two Conditions)':'Casos (duas condições)','Cases and Stacks':'Casos e empilhamentos','Category':'Categoria','Ceiling':'Teto','Centered as Group':'Centralizado como grupo','Change in y over change in x':'Variação de y sobre variação de x','Check':'Caron','Chicago':'Chicago','Circle area from its radius':'Área do círculo a p