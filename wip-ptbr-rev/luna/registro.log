1576:fn references(app: &mut WordApp, ui: &mut Ui) {
1577:    group(ui, "Table of Contents", None, app, |ui, app| {
1578:        menu_button(ui, app, "toc", Some("Table of\nContents"), "Table of Contents", true, "references.toc", |ui, app| {
1579:            mi(ui, app, "Automatic Table 1 (3 levels)", "references.toc", json!({"levels": 3}));
1580:            mi(ui, app, "Automatic Table 2 (2 levels)", "references.toc", json!({"levels": 2, "title": "Table of Contents"}));
1581:            ui.separator();
1582:            mi(ui, app, "Custom Table of Contentsâ€¦", "ui.dialog", json!({"name": "toc"}));
1583:            mi(ui, app, "Remove Table of Contents", "references.removeToc", json!({}));
1584:        });
1585:        stack(ui, |ui| {
1586:            menu_button(ui, app, "addText", Some("Add Text"), "Add Text", false, "references.addText", |ui, app| {
1587:                mi(ui, app, "Do Not Show in TOC", "references.addText", json!({"level": 0}));
1588:                for l in 1..=3u64 {
1589:                    mi(ui, app, &format!("Level {l}"), "references.addText", json!({"level": l}));
1590:                }
1591:            });
1592:            small(ui, app, "updateTable", Some("Update Table"), "Update Table", "references.updateToc", json!({}), false);
1593:        });
1594:    });
1595:    group(ui, "Footnotes", Some("references.noteOptions"), app, |ui, app| {
1596:        big(ui, app, "footnote", "Insert\nFootnote", "references.footnote", json!({}), false);
1597:        stack(ui, |ui| {
1598:            small(ui, app, "endnote", Some("Insert Endnote"), "Insert Endnote", "references.endnote", json!({}), false);
1599:            small(ui, app, "nextFootnote", Some("Next Footnote"), "Next Footnote", "references.nextFootnote", json!({}), false);
1600:            small(ui, app, "showNotes", Some("Show Notes"), "Show Notes", "references.notes", json!({}), false);
1601:        });
1602:    });
1603:    group(ui, "Research", None, app, |ui, app| {
1604:        big(ui, app, "researcher", "Researcher", "references.researcher", json!({}), false);
1605:    });
1606:    group(ui, "Citations & Bibliography", None, app, |ui, app| {
1607:        // The document's sources to cite, then a new one (Create Source, #402).
1608:        menu_button(ui, app, "citation", Some("Insert\nCitation"), "Insert Citation", true, "", |ui, app| {
1609:            let sources: Vec<(String, String)> =
1610:                app.session.doc.sources.iter().map(|s| (s.tag.clone(), format!("{} â€” {}", s.author, s.title))).collect();
1611:            for (tag, label) in sources {
1612:                mi_text(ui, app, &label, "references.citation", json!({"tag": tag}));
1613:            }
1614:            if !app.session.doc.sources.is_empty() {
1615:                ui.separator();
1616:            }
1617:            mi(ui, app, "Add New Sourceâ€¦", "ui.dialog", json!({"name": "createSource"}));
1618:        });
1619:        stack(ui, |ui| {
1620:            small(ui, app, "sources", Some("Manage Sources"), "Manage Sources", "references.sources", json!({}), false);
1621:            let current = app.session.bib_style.clone();
1622:            let label = crate::i18n::fmt(tl!("Style: {style}"), &[("style", &current)]);
1623:            menu_button(ui, app, "styles", Some(&label), "Citation Style", false, "references.citationStyle", |ui, app| {
1624:                for st in &wordcraft_engine::cmd::citations::STYLES {
1625:                    mi_check(ui, app, st.name, st.name == current, "references.citationStyle", json!({"style": st.name}));
1626:                }
1627:            });
1628:            small(ui, app, "bibliography", Some("Bibliography"), "Bibliography", "references.bibliography", json!({}), false);
1629:        });
1630:    });
1631:    group(ui, "Captions", None, app, |ui, app| {
1632:        big(ui, app, "caption", "Insert\nCaption", "references.caption", json!({}), false);
1633:        stack(ui, |ui| {
1634:            small(
1635:                ui,
1636:                app,
1637:                "tableOfFigures",
1638:                Some("Insert Table of Figures"),
1639:                "Insert Table of Figures",
1640:                "references.tableOfFigures",
1641:                json!({}),
1642:                false,
1643:            );
1644:            small(ui, app, "update", Some("Update Table"), "Update Table of Figures", "references.updateFigures", json!({}), false);
1645:            small(ui, app, "crossRef", Some("Cross-reference"), "Cross-reference", "insert.crossReference", json!({}), false);
1646:        });
1647:    });
1648:    group(ui, "Index", None, app, |ui, app| {
1649:        big(ui, app, "markEntry", "Mark\nEntry", "references.markEntry", json!({}), false);
1650:        stack(ui, |ui| {
1651:            small(ui, app, "index", Some("Insert Index"), "Insert Index", "references.index", json!({}), false);
1652:            small(ui, app, "update", Some("Update Index"), "Update Index", "references.updateIndex", json!({}), false);
1653:        });
1654:    });
1655:    group(ui, "Table of Authorities", None, app, |ui, app| {
1656:        big(ui, app, "markCitation", "Mark\nCitation", "references.markCitation", json!({}), false);
1657:        stack(ui, |ui| {
1658:            small(
1659:                ui,
1660:                app,
1661:                "tableOfAuthorities",
1662:                Some("Insert Table of Authorities"),
1663:                "Insert Table of Authorities",
1664:                "references.tableOfAuthorities",
1665:                json!({}),
1666:                false,
1667:            );
1668:            small(ui, app, "update", Some("Update Table"), "Update Table", "references.updateAuthorities", json!({}), false);
1669:        });
1670:    });
1671:}
