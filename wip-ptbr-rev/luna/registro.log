413: /// A built-in style's English name in the current language; numbered families go through one
414: /// template each (`Heading {n}`), and names without a translation stay English.
415: pub fn builtin_style_name(name: &str) -> String {
416:     let direct = t(name);
417:     if direct != name {
418:         return direct.to_string();
419:     }
420:     for (prefix, template) in [("Heading ", "Heading {n}"), ("TOC ", "TOC {n}"), ("Index ", "Index {n}")] {
421:         if let Some(n) = name.strip_prefix(prefix)
422:             && !n.is_empty()
423:             && n.chars().all(|c| c.is_ascii_digit())
424:         {
425:             return fmt(t(template), &[("n", n)]);
426:         }
427:     }
428:     name.to_string()
429: }
430: 
431: /// A ribbon location (`Home › Font`) in the current language, segment by segment.
432: pub fn location(loc: &str) -> String {
433:     loc.split(" › ").map(t).collect::<Vec<_>>().join(" › ")
434: }
435: 
436: /// A label with an action after a fixed English prefix, e.g. `Undo Typing`: both parts translated
437: /// where the catalog has them.
438: pub fn prefixed(prefix: &str, rest: &str) -> String {
439:     if rest.is_empty() {
440:         return t(prefix).to_string();
441:     }
442:     fmt(t(&format!("{prefix} {{action}}")), &[("action", t(rest))])
443: }
444: 
445: /// Fill `{name}` placeholders in one pass. Unknown placeholders stay as written, and inserted
446: /// values are never read as templates again, so a file name containing `{n}` stays intact.
447: pub fn fmt(template: &str, args: &[(&str, &str)]) -> String {
448:     let mut out = String::with_capacity(template.len());
449:     let mut rest = template;
450:     while let Some((before, after_open)) = rest.split_once('{') {
451:         out.push_str(before);
452:         let Some((name, after_close)) = after_open.split_once('}') else {
453:             out.push('{');
454:             out.push_str(after_open);
455:             return out;
456:         };
457:         match args.iter().find(|(key, _)| *key == name) {
458:             Some((_, value)) => out.push_str(value),
459:             None => {
460:                 out.push('{');
461:                 out.push_str(name);
462:                 out.push('}');
463:             }
464:         }
465:         rest = after_close;
466:     }
467:     out.push_str(rest);
468:     out
469: }
470: 

