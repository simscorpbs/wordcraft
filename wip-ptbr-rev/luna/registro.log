+import csv, re
+
+def translate(ctx, en):
+    if en == 'All - Linear': return 'Todas - Linear'
+    if en == 'All - Professional': return 'Todas - Profissional'
+    if en == 'Type a command, e.g. \\"insert table\\"': return 'Digite um comando, por exemplo \\"insert table\\"'
+    # Regras produtivas da galeria de equacoes e dos modelos do Word.
+    m = re.fullmatch(r'([0-9]+×[0-9]+) Empty Matrix', en)
+    if m: return f'Matriz vazia {m.group(1)}'
+    m = re.fullmatch(r'([0-9]+×[0-9]+) Identity Matrix(?: \(sparse\))?', en)
+    if m: return f'Matriz de identidade {m.group(1)}' + (' (esparsa)' if '(sparse)' in en else '')
+    m = re.fullmatch(r'([0-9]+×[0-9]+) Matrix in (Parentheses|Brackets|Double Bars)', en)
+    if m: return f'Matriz {m.group(1)} ' + {'Parentheses':'entre parênteses','Brackets':'entre colchetes','Double Bars':'entre barras duplas'}[m.group(2)]
+    if en == '2×2 Determinant': return 'Determinante 2×2'
+    m = re.fullmatch(r'(n×n) (Identity )?Matrix', en)
+    if m: return ('Matriz de identidade ' if m.group(2) else 'Matriz ') + m.group(1)
+    if ctx == 'preview' and en == 'Title': return 'Título'
+    if ctx == 'template' and en == 'Letter': return 'Carta'
