LOWER = {'a','Ã ','ao','aos','as','Ã s','atÃ©','com','como','da','das','de','do','dos','e','em','entre','na','nas','no','nos','o','os','ou','para','por','sem','sobre','um','uma','uns','umas'}
SENTENCE = {
    'Body text in a short paragraph to show spacing.','Capitalize the first word of a sentence','Convert between built-up and linear form','Find â€œ{text}â€ in the document',
    'A xor B','x bar','Good afternoon','Good evening','Good morning','Normal speed','Continue without restoring','Top of the Document',
