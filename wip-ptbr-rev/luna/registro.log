1673:fn mailings(app: &mut WordApp, ui: &mut Ui) {
1674:    group(ui, "Create", None, app, |ui, app| {
1675:        big(ui, app, "envelope", "Envelopes", "mailings.envelopes", json!({}), false);
1676:        big(ui, app, "labels", "Labels", "mailings.labels", json!({}), false);
1677:    });
1678:    group(ui, "Start Mail Merge", None, app, |ui, app| {
1679:        // The kinds of merge document the engine makes, the current one checked.
1680:        menu_button(ui, app, "mailMerge", Some("Start Mail\nMerge"), "Start Mail Merge", true, "mailings.start", |ui, app| {
1681:            let kind = app.session.merge.kind.clone();
1682:            for (label, k) in [
1683:                ("Letters", "letters"),
1684:                ("E-mail Messages", "emails"),
1685:                ("Envelopes", "envelopes"),
1686:                ("Labels", "labels"),
1687:                ("Directory", "directory"),
1688:                ("Normal Word Document", "normal"),
1689:            ] {
1690:                let current = kind == k || (k == "normal" && kind.is_empty());
1691:                mi_check(ui, app, label, current, "mailings.start", json!({"kind": k}));
1692:            }
1693:        });
1694:        // The command needs data, so the button offers the two ways to give it (#240).
1695:        menu_button(ui, app, "recipients", Some("Select\nRecipients"), "Select Recipients", true, "mailings.recipients", |ui, app| {
1696:            mi(ui, app, "Type a New Listâ€¦", "ui.dialog", json!({"name": "newRecipientList"}));
1697:            mi(ui, app, "Use an Existing Listâ€¦", "ui.openRecipientList", json!({}));
1698:        });
1699:        big(ui, app, "editRecipients", "Edit\nRecipient List", "mailings.editRecipients", json!({}), false);
1700:    });
1701:    group(ui, "Write & Insert Fields", None, app, |ui, app| {
1702:        big(ui, app, "highlightFields", "Highlight\nMerge Fields", "mailings.highlightFields", json!({}), false);
1703:        big(ui, app, "addressBlock", "Address\nBlock", "mailings.addressBlock", json!({}), false);
1704:        big(ui, app, "greetingLine", "Greeting\nLine", "mailings.greetingLine", json!({}), false);
1705:        big(ui, app, "mergeField", "Insert Merge\nField", "mailings.insertField", json!({}), false);
1706:        stack(ui, |ui| {
1707:            // The merge rules the engine knows; If and Skip Record If ask for their condition.
1708:            menu_button(ui, app, "rules", Some("Rules"), "Rules", false, "mailings.rules", |ui, app| {
1709:                mi(ui, app, "Ifâ€¦Thenâ€¦Elseâ€¦", "mailings.rules", json!({"rule": "IF"}));
1710:                mi(ui, app, "Merge Record #", "mailings.rules", json!({"rule": "MERGEREC"}));
1711:                mi(ui, app, "Next Record", "mailings.rules", json!({"rule": "NEXT"}));
1712:                mi(ui, app, "Skip Record Ifâ€¦", "mailings.rules", json!({"rule": "SKIPIF"}));
1713:            });
1714:            small(ui, app, "matchFields", Some("Match Fields"), "Match Fields", "mailings.matchFields", json!({}), false);
1715:        });
1716:    });
1717:    group(ui, "Preview Results", None, app, |ui, app| {
1718:        big(ui, app, "preview", "Preview\nResults", "mailings.preview", json!({}), false);
1719:        stack(ui, |ui| {
1720:            crate::widgets::row(ui, |ui| {
1721:                small(ui, app, "previous", None, "Previous Record", "mailings.previous", json!({}), false);
1722:                small(ui, app, "next", None, "Next Record", "mailings.next", json!({}), false);
1723:            });
1724:            small(ui, app, "find", Some("Find Recipient"), "Find Recipient", "mailings.findRecipient", json!({}), false);
1725:            small(ui, app, "checkErrors", Some("Check for Errors"), "Check for Errors", "mailings.checkErrors", json!({}), false);
1726:        });
1727:    });
1728:    group(ui, "Finish", None, app, |ui, app| {
1729:        big(ui, app, "finish", "Finish &\nMerge", "mailings.finish", json!({}), false);
1730:    });
1731:}
