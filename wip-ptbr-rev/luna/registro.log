# The escaped command may be represented with one backslash in the parsed field.
for r in data:
    if r[2]=='Type a command, e.g. \\\\\"insert table\\\\\"':
        r[4]='Digite um comando, por exemplo \\\\\"inserir tabela\\\\\"'

