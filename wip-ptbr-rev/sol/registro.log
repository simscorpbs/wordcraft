823 fn toc_options_ui(app: &mut WordApp, ui: &mut Ui, f: &mut TocForm, was: &TocForm) -> Next {
824     heading(ui, "Collect entries from:");
825     ui.checkbox(&mut f.heading_styles, crate::i18n::fmt(tl!("Heading styles (levels 1–{n})"), &[("n", &f.levels.to_string())]));
826     ui.label(tl!("Other styles and their TOC level:"));
827     // A solid scroll bar takes its own room beside the list instead of floating over the level boxes.
828     ui.spacing_mut().scroll = egui::style::ScrollStyle::solid();
829     egui::ScrollArea::vertical().max_height(180.0).show(ui, |ui| {
830         egui::Grid::new("toc_styles").num_columns(2).spacing(vec2(10.0, 3.0)).show(ui, |ui| {
831             for (name, level) in f.style_levels.iter_mut() {
832                 // Built-in styles read in the interface language; the document keeps the English name.
833                 let shown = app.session.doc.styles.styles.iter().find(|st| st.name == *name).map_or_else(|| name.clone(), crate::i18n::style_name);
834                 ui.label(shown);
835                 ui.add(egui::DragValue::new(level).range(0..=9).custom_formatter(|v, _| if v < 0.5 { String::new() } else { format!("{v:.0}") }));
836                 ui.end_row();
837             }
838         });
839     });
840     ui.checkbox(&mut f.outline_levels, tl!("Outline levels"));
841     ui.checkbox(&mut f.tc_fields, tl!("TC entry fields"));
842     ui.add_space(4.0);
843     if ui.button(tl!("Reset")).clicked() {
844         f.heading_styles = true;
845         f.outline_levels = true;
846         f.tc_fields = false;
847         for (_, l) in f.style_levels.iter_mut() {
848             *l = 0;
849         }
850     }
851     let (ok, cancel) = buttons(ui, tl!("OK"));
852     if ok {
853         return go(RefsDialog::Toc(f.clone()));
854     }
855     if cancel {
856         return go(RefsDialog::Toc(was.clone()));
857     }
858     Next::Stay
859 }
