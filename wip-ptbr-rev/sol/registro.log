74:/// Describe the document under the canvas widget `doc_id` to AccessKit for this frame.
75:/// `rects` are the pages' screen rectangles, `view` the visible part of the canvas.
76:pub fn expose(app: &mut crate::WordApp, ctx: &egui::Context, doc_id: Id, layout: &Arc<DocLayout>, rects: &[Rect], view: Rect) {
77:    if ctx.accesskit_node_builder(doc_id, |n| n.set_role(Role::Document)).is_none() {
78:        // No screen reader: describe nothing, keep nothing.
79:        app.canvas.a11y = A11yCache::default();
80:        return;
81:    }
82:    let pages = page_window(rects, view).unwrap_or((0, 0));
83:    let sel = (app.session.sel.anchor.clone(), app.session.sel.focus.clone());
84:    let key = Key { layout: layout.clone(), doc: doc_id, pages, rects: rects.get(pages.0..pages.1).unwrap_or_default().to_vec(), sel };
85:    if !app.canvas.a11y.key.as_ref().is_some_and(|k| k.same(&key)) {
86:        app.canvas.a11y.tree = build(&app.session.doc, layout, doc_id, rects, pages, (&key.sel.0, &key.sel.1));
87:        app.canvas.a11y.key = Some(key);
88:    }
89:    let title = app.title_stem();
90:    let tree = &app.canvas.a11y.tree;
91:    let ours: HashSet<NodeId> = tree.nodes.iter().map(|(id, _)| id.accesskit_id()).collect();
92:    for (id, node) in &tree.nodes {
93:        ctx.accesskit_node_builder(*id, |n| *n = node.clone());
94:    }
95:    // egui hangs every new node off the window; ours belong under the document.
96:    ctx.accesskit_node_builder(egui::accesskit_root_id(), |root| {
97:        let keep: Vec<NodeId> = root.children().iter().filter(|c| !ours.contains(c)).copied().collect();
98:        root.set_children(keep);
99:    });
100:    ctx.accesskit_node_builder(doc_id, |n| {
101:        n.set_label(title);
102:        for c in &tree.top {
103:            n.push_child(*c);
104:        }
105:        match &tree.selection {
106:            Some(s) => n.set_text_selection(*s),
107:            None => n.clear_text_selection(),
108:        }
109:    });
110:}
111:
112:/// Build the description of pages `pages.0..pages.1`.
113:pub fn build(doc: &Document, layout: &DocLayout, doc_id: Id, rects: &[Rect], pages: (usize, usize), sel: (&Pos, &Pos)) -> Tree {
114:    let mut b = Builder { doc, doc_id, tree: Tree::default(), index: HashMap::new(), lists: HashMap::new(), offsets: HashMap::new() };
115:    for pi in pages.0..pages.1 {
116:        let (Some(page), Some(pr)) = (layout.pages.get(pi), rects.get(pi)) else { continue };
117:        let scale = crate::canvas::page_screen_scale(*pr, page, 1.0);
118:        let to_screen = |r: wordcraft_geom::Rect| {
119:            Rect::from_min_size(egui::pos2(pr.min.x + r.x * scale, pr.min.y + r.y * scale), egui::vec2(r.w * scale, r.h * scale))
120:        };
121:        // Where floating pictures sit (their anchor character takes no room on its line).
122:        let mut pictures: HashMap<(&[u32], usize), Rect> = HashMap::new();
123:        for it in &page.items {
124:            if let Placed::Image { rect, story: StoryRef::Body, path, off, .. } | Placed::Graphic { rect, story: StoryRef::Body, path, off, .. } = it
125:            {
126:                pictures.insert((path.0.as_slice(), *off), to_screen(*rect));
127:            }
128:        }
129:        for it in &page.items {
130:            if b.full() {
131:                break;
132:            }
133:            let Placed::Lines { story: StoryRef::Body, path, para, l0, l1, x, y, turn } = it else { continue };
134:            let place = LinePlace { x: *x, y: *y, turn: *turn, scale, origin: pr.min };
135:            b.paragraph(path, para, *l0..*l1, &place, &pictures);
136:        }
137:    }
138:    let at = |p: &Pos| if p.story == StoryRef::Body { b.position(&p.path, p.off) } else { None };
139:    b.tree.selection = match (at(sel.0), at(sel.1)) {
140:        (Some(anchor), Some(focus)) => Some(TextSelection { anchor, focus }),
141:        (None, Some(focus)) => Some(TextSelection { anchor: focus, focus }),
142:        _ => None,
143:    };
144:    b.tree
145:}
