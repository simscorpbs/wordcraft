319         ui.vertical(|ui| {
320             ui.spacing_mut().item_spacing = vec2(1.0, 0.0);
321             let info = app.session.run("equation.get", &json!({})).ok();
322             let display = info.as_ref().and_then(|v| v.get("display")).and_then(|v| v.as_bool()).unwrap_or(false);
323             let numbered = info.as_ref().and_then(|v| v.get("linear")).and_then(|v| v.as_str()).is_some_and(|l| l.contains('#'));
324             small(
325                 ui,
326                 app,
327                 "alignCenter",
328                 Some("Display"),
329                 "Show the equation on a line of its own",
330                 "equation.display",
331                 json!({"value": true}),
332                 display,
333             );
334             small(
335                 ui,
336                 app,
337                 "alignLeft",
338                 Some("Inline"),
339                 "Show the equation in the line of text",
340                 "equation.display",
341                 json!({"value": false}),
342                 !display,
343             );
344             small(
345                 ui,
346                 app,
347                 "numbering",
348                 Some("Number"),
349                 "Number the equation; the number sits at the right margin (or type # then the number)",
350                 "equation.number",
351                 json!({}),
352                 numbered,
353             );
354         });
355         ui.vertical(|ui| {
356             ui.spacing_mut().item_spacing = vec2(1.0, 0.0);
357             crate::widgets::menu_button(
358                 ui,
359                 app,
360                 "justify",
361                 Some("Justification"),
362                 "Justification of a display equation",
363                 false,
364                 "equation.justify",
365                 |ui, app| {
366                     for (label, jc) in [("Left", "left"), ("Right", "right"), ("Centered", "center"), ("Centered as Group", "centerGroup")] {
367                         if ui.button(tl!(label)).clicked() {
368                             let _ = app.run("equation.justify", json!({"jc": jc}));
369                             ui.close();
370                         }
371                     }
372                 },
373             );
374             if ui.button(tl!("Close Equation")).on_hover_text(tl!("Leave the equation (Esc)")).clicked() {
375                 let _ = app.run("equation.exit", json!({}));
376                 app.canvas.want_focus = true;
377             }
378         });
379     });
380 }

