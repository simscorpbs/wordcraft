3418:/// Search's filter: every word of the query is in the command's label, location or id, in English
3419:/// or in the interface language, so "insert table" finds Insert › Tables › Table (#819).
3420:fn command_matches(c: &wordcraft_engine::CommandSpec, query: &str) -> bool {
3421:    if query.trim().is_empty() {
3422:        return false;
3423:    }
3424:    let hay = format!(
3425:        "{} {} {} {} {}",
3426:        c.label.to_lowercase(),
3427:        c.location.to_lowercase(),
3428:        c.id.to_lowercase(),
3429:        crate::i18n::lowercase(tl!(c.label)),
3430:        crate::i18n::lowercase(&crate::i18n::location(c.location))
3431:    );
3432:    query.split_whitespace().all(|w| hay.contains(&w.to_lowercase()) || hay.contains(&crate::i18n::lowercase(w)))
3433:}
