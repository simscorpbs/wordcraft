1226 /// The command that picks up `tool`.
1227 fn pen_command(tool: wordcraft_doc::freeform::InkTool) -> &'static str {
1228     use wordcraft_doc::freeform::InkTool;
1229     match tool {
1230         InkTool::Pen => "draw.pen",
1231         InkTool::Pencil => "draw.pencil",
1232         InkTool::Highlighter => "draw.highlighter",
1233     }
1234 }
1235 
1236 /// After the colour or thickness menu changed `tool`'s settings, the gallery pen that was in use
1237 /// (`custom`) takes them too.
1238 fn update_gallery_pen(app: &mut WordApp, custom: Option<usize>, tool: wordcraft_doc::freeform::InkTool) {
1239     let set = app.session.view.draw.settings(tool);
1240     if let Some(p) = custom.and_then(|i| app.session.view.draw.pens.get_mut(i))
1241         && p.kind == tool
1242     {
1243         p.color = set.color;
1244         p.width = set.width;
1245     }
1246 }
1247 
1248 /// A pen of the gallery: its kind's icon over a bar of its colour and thickness; a click picks it
1249 /// up, right-click offers Remove Pen.
1250 fn gallery_pen(ui: &mut Ui, app: &mut WordApp, i: usize, pen: wordcraft_engine::cmd::draw::CustomPen, active: bool) {
1251     use wordcraft_doc::freeform::InkTool;
1252     let t = Tokens::get(ui.ctx());
1253     let (r, resp) = ui.allocate_exact_size(vec2(34.0, CONTENT_H), Sense::click());
1254     crate::widgets::bg(ui, r, &resp, active, &t);
1255     let icon = match pen.kind {
1256         InkTool::Pen => "pen",
1257         InkTool::Pencil => "pencil",
1258         InkTool::Highlighter => "highlight",
1259     };
1260     let color = crate::theme::c32(pen.color);
1261     icons::paint(ui.painter(), Rect::from_center_size(pos2(r.center().x, r.min.y + 20.0), vec2(28.0, 28.0)), icon, t.icon, color);
1262     let bar = (pen.width * 0.6).clamp(1.5, 8.0);
1263     let y = r.min.y + 46.0;
1264     ui.painter().line_segment([pos2(r.min.x + 6.0, y), pos2(r.max.x - 6.0, y)], Stroke::new(bar, color));
1265     let kind = tl!(match pen.kind {
1266         InkTool::Pen => "Pen",
1267         InkTool::Pencil => "Pencil",
1268         InkTool::Highlighter => "Highlighter",
1269     });
1270     let size = crate::i18n::fmt(tl!("{n} pt"), &[("n", &pen.width.to_string())]);
1271     let resp = resp.on_hover_text(format!("{kind}: {size}, #{}", pen.color.hex()));
1272     if resp.clicked() {
1273         let _ = app.run(pen_command(pen.kind), json!({"color": pen.color.hex(), "width": pen.width}));
1274     }
1275     resp.context_menu(|ui| {
1276         if ui.button(tl!("Remove Pen")).clicked() {
1277             let _ = app.run("draw.removePen", json!({"index": i}));
1278             ui.close();
1279         }
1280     });
1281 }
