179:/// The Symbols group: a strip of the current set's symbols, and a menu with every set.
180:fn symbols(ui: &mut Ui, app: &mut WordApp) {
181:    let id = egui::Id::new("eq_symbol_set");
182:    let set = ui.data(|d| d.get_temp::<usize>(id)).unwrap_or(0).min(SYMBOL_SETS.len().saturating_sub(1));
183:    let Some((_, chars)) = SYMBOL_SETS.get(set) else { return };
184:    let start_id = egui::Id::new("eq_symbol_start");
185:    let per_row = 10usize;
186:    let rows = 3usize;
187:    let all: Vec<char> = chars.chars().collect();
188:    let start = ui.data(|d| d.get_temp::<usize>(start_id)).unwrap_or(0).min(all.len().saturating_sub(1));
189:    let t = Tokens::get(ui.ctx());
190:    ui.vertical(|ui| {
191:        ui.spacing_mut().item_spacing = vec2(1.0, 1.0);
192:        for row in 0..rows {
193:            ui.horizontal(|ui| {
194:                ui.spacing_mut().item_spacing = vec2(1.0, 1.0);
195:                for col in 0..per_row {
196:                    let k = start + row * per_row + col;
197:                    let Some(c) = all.get(k) else {
198:                        ui.allocate_exact_size(vec2(22.0, 22.0), Sense::hover());
199:                        continue;
200:                    };
201:                    if symbol_button(ui, app, *c, &t) {
202:                        let _ = app.run("equation.insertSymbol", json!({"char": c.to_string()}));
203:                        app.canvas.want_focus = true;
204:                    }
205:                }
206:            });
207:        }
208:    });
209:    ui.vertical(|ui| {
210:        ui.spacing_mut().item_spacing = vec2(0.0, 1.0);
211:        let page = per_row * rows;
212:        if ui.add_enabled(start > 0, egui::Button::new("▲").min_size(vec2(16.0, 22.0))).clicked() {
213:            ui.data_mut(|d| d.insert_temp(start_id, start.saturating_sub(per_row)));
214:        }
215:        if ui.add_enabled(start + page < all.len(), egui::Button::new("▼").min_size(vec2(16.0, 22.0))).clicked() {
216:            ui.data_mut(|d| d.insert_temp(start_id, start + per_row));
217:        }
218:        let resp = ui.add(egui::Button::new("…").min_size(vec2(16.0, 22.0))).on_hover_text(tl!("All symbol sets"));
219:        egui::Popup::menu(&resp).show(|ui| {
220:            ui.set_width(420.0);
221:            ui.horizontal_wrapped(|ui| {
222:                for (i, (name, _)) in SYMBOL_SETS.iter().enumerate() {
223:                    if ui.selectable_label(i == set, tl!(name)).clicked() {
224:                        ui.data_mut(|d| {
225:                            d.insert_temp(id, i);
226:                            d.insert_temp(start_id, 0usize);
227:                        });
228:                    }
229:                }
230:            });

