263 /// The Equation tab.
264 pub fn show(app: &mut WordApp, ui: &mut Ui) {
265     group(ui, "Tools", None, app, |ui, app| {
266         math_menu_button(ui, app, "∑_(i=1)^n", "Equation", builtin_menu);
267         ui.vertical(|ui| {
268             ui.spacing_mut().item_spacing = vec2(1.0, 0.0);
269             let latex = app.session.math_latex;
270             small(
271                 ui,
272                 app,
273                 "equation",
274                 Some("Unicode"),
275                 "Type equations in the linear format (UnicodeMath)",
276                 "equation.inputFormat",
277                 json!({"format": "unicode"}),
278                 !latex,
279             );
280             small(ui, app, "formula", Some("LaTeX"), "Type equations in LaTeX", "equation.inputFormat", json!({"format": "latex"}), latex);
281             crate::widgets::menu_button(
282                 ui,
283                 app,
284                 "replace",
