148:    /// The `review.compare` / `review.combine` parameters; `None` until a revised document is
149:    /// chosen.
150:    pub fn params(&self) -> Option<Value> {
151:        let revised = self.revised.trim();
152:        if revised.is_empty() || (!self.original_current && self.original.trim().is_empty()) {
153:            return None;
154:        }
155:        let mut v = json!({
156:            "path": revised,
157:            "author": self.author.trim(),
158:            "level": if self.character_level { "character" } else { "word" },
159:            "showIn": self.show_in,
160:        });
161:        if !self.original_current {
162:            v["original"] = json!(self.original.trim());
163:        }
164:        for ((key, _), on) in COMPARE_SETTINGS.iter().zip(self.settings) {
165:            v[*key] = json!(on);
166:        }
167:        Some(v)
168:    }
