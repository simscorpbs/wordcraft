93:pub struct InterfaceSize(Option<u16>);
94:
95:impl InterfaceSize {
96:    pub const MIN: u16 = 50;
97:    pub const MAX: u16 = 300;
98:    /// Follow the display scale the system reports.
99:    pub const AUTO: InterfaceSize = InterfaceSize(None);
100:    /// The sizes File › Options offers after Auto, in percent (PhotoCraft's and PdfCraft's).
101:    pub const PRESETS: [u16; 12] = [75, 80, 85, 90, 95, 100, 125, 150, 175, 200, 250, 300];
102:
103:    /// A chosen size from any number: rounded and clamped to 50–300 %; `None` for NaN or infinity.
104:    pub fn from_percent(percent: f64) -> Option<InterfaceSize> {
105:        percent.is_finite().then(|| InterfaceSize(Some(percent.round().clamp(f64::from(Self::MIN), f64::from(Self::MAX)) as u16)))
106:    }
107:
108:    /// The chosen size in percent, or `None` for Auto.
109:    pub fn percent(self) -> Option<u16> {
110:        self.0
111:    }
