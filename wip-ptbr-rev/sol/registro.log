1161 fn draw(app: &mut WordApp, ui: &mut Ui) {
1162     use wordcraft_doc::freeform::InkTool;
1163     use wordcraft_engine::cmd::draw::{DrawMode, lasso_selection};
1164     let mode = app.session.view.draw.mode;
1165     // The pen the colour and thickness menus change: the one in use, else the pen.
1166     let tool = mode.pen().unwrap_or(InkTool::Pen);
1167     let set = app.session.view.draw.settings(tool);
1168     // The gallery pen in use, if any: changing the colour or thickness changes it too.
1169     let custom =
1170         app.session.view.draw.pens.iter().position(|p| mode == DrawMode::Pen(p.kind) && p.color == set.color && (p.width - set.width).abs() < 0.01);
1171     let lasso_on = lasso_selection(&app.session).is_some();
1172     group(ui, "Drawing Tools", None, app, |ui, app| {
1173         big_toggle(ui, app, "select", "Select", "draw.select", mode == DrawMode::Select);
1174         big_toggle(ui, app, "lasso", "Lasso", "draw.lasso", mode == DrawMode::Lasso);
1175         big_toggle(ui, app, "eraser", "Eraser", "draw.eraser", mode == DrawMode::Eraser);
1176         big_toggle(ui, app, "pen", "Pen", "draw.pen", mode == DrawMode::Pen(InkTool::Pen) && custom.is_none());
1177         big_toggle(ui, app, "pencil", "Pencil", "draw.pencil", mode == DrawMode::Pen(InkTool::Pencil) && custom.is_none());
1178         big_toggle(ui, app, "highlight", "Highlighter", "draw.highlighter", mode == DrawMode::Pen(InkTool::Highlighter) && custom.is_none());
1179         // Pens added with Add Pen; right-click one to remove it.
1180         let pens = app.session.view.draw.pens.clone();
1181         for (i, pen) in pens.iter().enumerate() {
1182             gallery_pen(ui, app, i, *pen, custom == Some(i));
1183         }
1184         menu_button(ui, app, "addPen", Some("Add\nPen"), "Add Pen", true, "", |ui, app| {
1185             for (label, kind) in [("Pen", InkTool::Pen), ("Pencil", InkTool::Pencil), ("Highlighter", InkTool::Highlighter)] {
1186                 // A new pen starts as that kind's current colour and thickness.
