1198                 if !lasso_on {
1199                     update_gallery_pen(app, custom, tool);
1200                 }
1201             });
1202             menu_button(ui, app, "thickness", None, "Thickness", false, "draw.pen", |ui, app| {
1203                 let widths: &[f32] = if tool == InkTool::Highlighter { &[4.0, 8.0, 12.0, 18.0, 24.0] } else { &[0.5, 1.0, 1.5, 2.5, 3.5, 5.0] };
1204                 for w in widths {
1205                     let label = crate::i18n::fmt(tl!("{n} pt"), &[("n", &w.to_string())]);
1206                     mi_check(ui, app, &label, (set.width - w).abs() < 0.01, pen_command(tool), json!({"width": w}));
1207                 }
1208                 update_gallery_pen(app, custom, tool);
1209             });
1210         });
1211     });
1212     group(ui, "Convert", None, app, |ui, app| {
1213         let on = app.session.view.draw.ink_to_shape;
1214         big_toggle(ui, app, "inkToShape", "Ink to\nShape", "draw.inkToShape", on);
1215         big(ui, app, "inkToMath", "Ink to\nMath", "draw.inkToMath", json!({}), false);
1216     });
