80:/// The equation the caret is at: on its U+FFFC or just after it (or the one being edited).
81:fn equation_at_caret(s: &Session) -> Option<Pos> {
82:    if let Some(m) = &s.math {
83:        return Some(m.at.clone());
84:    }
85:    let f = &s.sel.focus;
86:    let para = s.doc.para_at(f)?;
87:    let is_eq = |off: usize| matches!(para.object_at(off), Some(InlineObject::Equation { .. }));
88:    if is_eq(f.off) {
89:        return Some(f.clone());
90:    }
91:    let before = f.off.checked_sub(OBJ.len_utf8())?;
92:    if is_eq(before) {
93:        return Some(Pos { off: before, ..f.clone() });
94:    }
95:    // A selection holding exactly one equation.
96:    let (a, b) = s.sel.ordered();
97:    if a.path == b.path && b.off == a.off + OBJ.len_utf8() && is_eq(a.off) {
98:        return Some(a);
99:    }
100:    None
101:}
102:
103:/// Run `f` on the equation at `at`; keeps its linear text in step and drops the source OMML
104:/// (it no longer matches).
105:fn with_eq<R>(s: &mut Session, at: &Pos, f: impl FnOnce(&mut Math, &mut bool) -> R) -> Result<R, CmdError> {
106:    let para = s.doc.para_mut(at.story, &at.path)?;
107:    let Some(InlineObject::Equation { linear, display, math }) = para.object_at_mut(at.off) else {
108:        return Err(CmdError::Failed("no equation there".into()));
109:    };
110:    if math.nodes.is_empty() && !linear.is_empty() && !math.linear {
111:        math.nodes = parse_linear(linear);
112:    }
113:    let r = f(math, display);
114:    *linear = if math.linear { plain(&math.nodes) } else { to_linear(&math.nodes) };
115:    math.omml.clear();
116:    para.touch();
117:    Ok(r)
118:}
119:
120:/// All the text of an equation's runs (its linear form while shown linear).

