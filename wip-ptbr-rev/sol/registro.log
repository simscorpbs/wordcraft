271:fn table(ui: &mut egui::Ui, list: &[&Contributor], v: &mut View) {
272:    egui::Grid::new("credits_table").striped(true).num_columns(SortKey::ALL.len()).show(ui, |ui| {
273:        for k in SortKey::ALL {
274:            let arrow = if v.key == k { if v.ascending { " ▲" } else { " ▼" } } else { "" };
275:            if ui.button(RichText::new(format!("{}{arrow}", tl!(k.label().1))).strong()).on_hover_text(tl!(k.label().0)).clicked() {
276:                if v.key == k {
277:                    v.ascending = !v.ascending;
278:                } else {
279:                    v.key = k;
280:                    v.ascending = k.default_ascending();
281:                }
282:            }
283:        }
284:        ui.end_row();
285:        for c in list {
286:            ui.hyperlink_to(c.name(v.names), format!("https://github.com/{}", c.login)).on_hover_text(c.summary());
287:            ui.label(group(c.prs));
288:            ui.label(group(c.commits));
289:            ui.label(group(c.lines_added));
290:            ui.label(group(c.lines_deleted));
291:            ui.label(signed(c.lines_delta()));
292:            ui.label(group(c.binary_added));
293:            ui.label(group(c.binary_deleted));
294:            ui.label(day(c.first_commit));
295:            ui.label(day(c.last_commit));
296:            ui.end_row();
297:        }
298:    });
299:}
