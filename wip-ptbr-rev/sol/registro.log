147:/// Where a paragraph's lines are placed: the `Placed::Lines` frame and the page on screen.
148:struct LinePlace {
149:    x: f32,
150:    y: f32,
151:    turn: TextDirection,
152:    scale: f32,
153:    origin: egui::Pos2,
154:}
155:
156:impl LinePlace {
157:    fn rect(&self, r: wordcraft_geom::Rect) -> Rect {
158:        let p = wordcraft_layout::turn_rect(self.turn, self.x, self.y, r);
159:        let s = self.scale;
160:        Rect::from_min_size(egui::pos2(self.origin.x + p.x * s, self.origin.y + p.y * s), egui::vec2(p.w * s, p.h * s))
161:    }
162:}
