1945 /// The Outlining tab (Outline view): outline levels, moving, expanding and collapsing, what is
1946 /// shown, and closing the view.
1947 fn outlining(app: &mut WordApp, ui: &mut Ui) {
1948     use wordcraft_engine::layout::outline::{BODY, para_level};
1949     let o = app.session.view.outline.clone();
1950     let level = app.session.doc.para_at(&app.session.sel.focus).map(|p| para_level(&app.session.doc, p)).unwrap_or(BODY);
1951     let name = |l: u8| if l >= BODY { tl!("Body Text").to_string() } else { crate::i18n::fmt(tl!("Level {n}"), &[("n", &l.to_string())]) };
1952     group(ui, "Outline Tools", None, app, |ui, app| {
1953         stack(ui, |ui| {
1954             crate::widgets::row(ui, |ui| {
1955                 small(ui, app, "outlineTop", None, "Promote to Heading 1", "outline.promoteToHeading1", json!({}), false);
1956                 small(ui, app, "outlinePromote", None, "Promote", "outline.promote", json!({}), false);
1957                 let levels: Vec<String> = (1..=BODY).map(name).collect();
1958                 if let Some(v) = combo(ui, "outlineLevel", 100.0, &name(level), &levels, None)
1959                     && let Some(i) = levels.iter().position(|x| *x == v)
1960                 {
1961                     let l = if i + 1 >= usize::from(BODY) { json!("body") } else { json!(i + 1) };
1962                     let _ = app.run("outline.level", json!({ "level": l }));
1963                 }
1964                 small(ui, app, "outlineDemote", None, "Demote", "outline.demote", json!({}), false);
1965                 small(ui, app, "outlineBody", None, "Demote to Body Text", "outline.demoteToBody", json!({}), false);
1966             });
1967             ui.add_space(3.0);
1968             crate::widgets::row(ui, |ui| {
1969                 small(ui, app, "outlineUp", None, "Move Up", "outline.moveUp", json!({}), false);
1970                 small(ui, app, "outlineDown", None, "Move Down", "outline.moveDown", json!({}), false);
1971                 small(ui, app, "outlineExpand", None, "Expand", "outline.expand", json!({}), false);
1972                 small(ui, app, "outlineCollapse", None, "Collapse", "outline.collapse", json!({}), false);
1973                 ui.add_space(6.0);
1974                 ui.label(egui::RichText::new(tl!("Show Level")).size(11.5));
1975                 let mut shown: Vec<String> = vec![tl!("All Levels").to_string()];
1976                 shown.extend((1..BODY).map(name));
1977                 let current = shown.get(usize::from(o.show_level)).cloned().unwrap_or_default();
1978                 if let Some(v) = combo(ui, "outlineShowLevel", 90.0, &current, &shown, None)
1979                     && let Some(i) = shown.iter().position(|x| *x == v)
1980                 {
1981                     let l = if i == 0 { json!("all") } else { json!(i) };
1982                     let _ = app.run("outline.showLevel", json!({ "level": l }));
1983                 }
1984             });
1985             ui.add_space(3.0);
1986             crate::widgets::row(ui, |ui| {
1987                 let mut f = !o.hide_formatting;
1988                 if ui.checkbox(&mut f, tl!("Show Text Formatting")).changed() {
1989                     let _ = app.run("outline.showFormatting", json!({ "value": f }));
1990                 }
1991                 let mut first = o.first_line_only;
1992                 if ui.checkbox(&mut first, tl!("Show First Line Only")).changed() {
1993                     let _ = app.run("outline.firstLineOnly", json!({ "value": first }));
1994                 }
1995             });
1996         });
1997     });
1998     group(ui, "Close", None, app, |ui, app| {
1999         big(ui, app, "closeOutline", "Close Outline\nView", "outline.close", json!({}), false);
2000     });
2001 }
