224:        ui.separator();
225:        ui.label(tl!("Sort"));
226:        egui::ComboBox::from_id_salt("credits_sort").selected_text(tl!(v.key.label().0)).show_ui(ui, |ui| {
227:            for k in SortKey::ALL {
228:                if ui.selectable_label(v.key == k, tl!(k.label().0)).clicked() {
229:                    v.key = k;
230:                    v.ascending = k.default_ascending();
231:                }
