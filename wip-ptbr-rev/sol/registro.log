2784:        let (Some(action), Some(label), Some(level)) =
2785:            (a.get("action").and_then(|v| v.as_str()), a.get("label").and_then(|v| v.as_str()), a.get("level").and_then(|v| v.as_u64()))
2786:        else {
2787:            continue;
2788:        };
2789:        if last_level.is_some_and(|l| l != level) {
2790:            ui.separator();
2791:        }
2792:        last_level = Some(level);
