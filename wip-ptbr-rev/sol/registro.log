48:/// A big ribbon button whose picture is an equation; opens `menu`.
49:fn math_menu_button(ui: &mut Ui, app: &mut WordApp, picture: &str, label: &str, menu: impl FnOnce(&mut Ui, &mut WordApp)) {
50:    let label = tl!(label);
51:    let t = Tokens::get(ui.ctx());
52:    let galley_w =
53:        label.split('\n').map(|l| ui.ctx().fonts_mut(|f| f.layout_no_wrap(l.to_string(), regular(11.5), t.text).size().x)).fold(0.0, f32::max);
54:    let w = (galley_w + 22.0).max(46.0);
55:    let (r, resp) = ui.allocate_exact_size(vec2(w, CONTENT_H), Sense::click());
56:    if resp.hovered() {
57:        ui.painter().rect_filled(r, 4.0, t.hover);
58:    }
59:    let pic = Rect::from_center_size(pos2(r.center().x, r.min.y + BIG_ICON_Y), vec2(40.0, 32.0));
60:    ui.painter().rect_filled(pic, 3.0, t.input);
61:    paint_math(app, ui, pic, &format!("btn:{picture}"), picture, None, false, 12.0);
62:    let lines: Vec<&str> = label.split('\n').collect();
63:    let mut y = r.min.y + BIG_LABEL_Y;
64:    for (i, l) in lines.iter().enumerate() {
65:        crate::widgets::label_line(ui, r.center().x, y, l, regular(11.5), t.text, i + 1 == lines.len());
66:        y += LABEL_PITCH;
67:    }
68:    let resp = resp.on_hover_text(label.replace('\n', " "));
69:    egui::Popup::menu(&resp).show(|ui| {
70:        ui.set_min_width(260.0);
71:        menu(ui, app);
72:    });
73:}
