517:    let at = equation_at_caret(s).ok_or_else(|| CmdError::Disabled("no equation at the caret".into()))?;
518:    let mut pos_reset = false;
519:    with_eq(s, &at, |math, display| {
520:        let numbered = matches!(math.nodes.as_slice(), [MNode::EqArr { rows }] if rows.iter().any(|r| wordcraft_doc::math::has_number_mark(r)));
521:        let want = p::bool(v, "value").unwrap_or(!numbered);
522:        if want && !numbered {
523:            let mut row = std::mem::take(&mut math.nodes);
524:            row.push(MNode::Run(wordcraft_doc::math::MRun::new("#")));
525:            math.nodes = vec![MNode::EqArr { rows: vec![row] }];
526:            *display = true;
527:            pos_reset = true;
528:        } else if !want && numbered {
529:            // Every row loses its number; a single row stands alone again, several stay an
530:            // array (#444).
531:            if let [MNode::EqArr { rows }] = math.nodes.as_mut_slice() {
532:                let mut rows: Vec<Arg> = std::mem::take(rows).into_iter().map(without_number).collect();
533:                math.nodes = if rows.len() == 1 { rows.pop().unwrap_or_default() } else { vec![MNode::EqArr { rows }] };
534:            }
535:            pos_reset = true;
536:        }
537:    })?;
538:    if pos_reset && let Some(m) = s.math.as_mut() {
539:        m.pos = MathPos::default();
540:    }
541:    s.clamp_selection();
542:    result(s)
543:}
544:
545:/// An equation-array row without its number: everything from the `#` on goes.
546:fn without_number(row: Arg) -> Arg {
547:    let mut out = Vec::new();
548:    for n in row {
549:        match n {
550:            MNode::Run(mut r) if !r.lit && r.text.contains('#') => {
551:                if let Some(k) = r.text.find('#') {
552:                    r.text.truncate(k);
553:                }
554:                if !r.text.is_empty() {
555:                    out.push(MNode::Run(r));
556:                }
557:                break;
558:            }
559:            n => out.push(n),
560:        }
561:    }
562:    out
563:}
