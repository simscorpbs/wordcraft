861 /// Modify… in Table of Contents: pick a TOC level style and edit it in Modify Style, which
862 /// comes back here when it closes.
863 fn toc_styles_ui(app: &mut WordApp, ui: &mut Ui, f: &mut TocForm, level: &mut u8) -> Next {
864     ui.label(tl!("Styles:"));
865     egui::ScrollArea::vertical().max_height(200.0).show(ui, |ui| {
866         for l in 1..=9u8 {
867             let name = app.session.doc.styles.get(&format!("TOC{l}")).map(|s| s.name.clone()).unwrap_or_else(|| format!("TOC {l}"));
868             ui.selectable_value(level, l, name);
869         }
870     });
871     ui.add_space(6.0);
872     if ui.button(tl!("Modify…")).clicked()
873         && let Some(mut d) = Dialog::modify_style(app, &format!("TOC{level}"))
874     {
875         if let Dialog::ModifyStyle { resume, .. } = &mut d {
876             *resume = Some(Box::new(Dialog::Refs(Box::new(RefsDialog::TocStyles { form: f.clone(), level: *level }))));
877         }
878         app.dialog = Some(d);
879         return Next::Close;
880     }
881     let (ok, cancel) = buttons(ui, tl!("OK"));
882     if ok || cancel { go(RefsDialog::Toc(f.clone())) } else { Next::Stay }
883 }
