95:/// A structure gallery's menu.
96:fn structure_menu(ui: &mut Ui, app: &mut WordApp, gallery_id: &str) {
97:    let Some(g) = STRUCTURES.iter().find(|g| g.id == gallery_id) else { return };
98:    egui::ScrollArea::vertical().max_height(520.0).show(ui, |ui| {
99:        ui.set_width(330.0);
100:        for (name, templates) in g.sections {
101:            section_heading(ui, name);
102:            let wide = name.starts_with("Common") || templates.iter().all(|t| !t.linear.contains('⬚')) && templates.len() <= 3;
103:            let size = if wide { vec2(158.0, 60.0) } else { vec2(60.0, 56.0) };
104:            ui.horizontal_wrapped(|ui| {
105:                ui.spacing_mut().item_spacing = vec2(4.0, 4.0);
106:                for tpl in templates.iter() {
107:                    if tile(ui, app, tpl, size) {
108:                        let _ = app.run("equation.insertStructure", json!({"id": tpl.id}));
109:                        app.canvas.want_focus = true;
110:                        ui.close();
111:                    }
112:                }
113:            });
114:            ui.add_space(4.0);
115:        }
116:    });
117:}
