88:fn section_heading(ui: &mut Ui, name: &str) {
89:    let t = Tokens::get(ui.ctx());
90:    let (r, _) = ui.allocate_exact_size(vec2(ui.available_width().max(240.0), 20.0), Sense::hover());
91:    ui.painter().rect_filled(r, 0.0, t.hover);
92:    ui.painter().text(pos2(r.min.x + 6.0, r.center().y), Align2::LEFT_CENTER, tl!(name), semibold(11.5), t.text);
