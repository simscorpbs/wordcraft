301                     }
302                 },
303             );
304         });
305         ui.vertical(|ui| {
306             ui.spacing_mut().item_spacing = vec2(1.0, 0.0);
307             let normal = app.session.math_normal_text;
308             small(ui, app, "case", Some("Normal Text"), "Type normal (non-math) text in the equation", "equation.normalText", json!({}), normal);
309         });
310     });
