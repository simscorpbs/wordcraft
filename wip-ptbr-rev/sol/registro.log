'@ | python -" in C:\Users\Brenno\ptbr-rev\sol
 succeeded in 157ms:
1://! Footnote and Endnote (References › Footnotes launcher, #385): where notes go, how they are
2://! numbered, for the whole document or the caret's section; Convert; Insert with a custom mark.
3://! The form ends in commands (`references.noteOptions`, `references.convertNotes`,
4://! `references.footnote` / `references.endnote`), so agents get the same result without it.
5:
6:use egui::{Ui, vec2};
7:use serde::Serialize;
8:use serde_json::{Value, json};
9:
10:use crate::WordApp;
11:use crate::theme::semibold;
12:
13:/// Number formats notes offer: OOXML name and a sample (not translated).
14:const FORMATS: [(&str, &str); 5] = [
15:    ("decimal", "1, 2, 3, …"),
16:    ("lowerLetter", "a, b, c, …"),
17:    ("upperLetter", "A, B, C, …"),
18:    ("lowerRoman", "i, ii, iii, …"),
19:    ("upperRoman", "I, II, III, …"),
20:];
21:
22:/// The dialog's fields; `[footnotes, endnotes]` where each kind has its own.
23:#[derive(Clone, Debug, PartialEq, Serialize)]
24:pub struct NoteForm {
25:    /// Which kind the format fields and Insert are for.
26:    pub endnote: bool,
27:    pub pos: [String; 2],
28:    pub fmt: [String; 2],
29:    pub start: [u32; 2],
30:    pub restart: [String; 2],
31:    /// A custom mark for Insert (empty: numbered).
32:    pub mark: String,
33:    /// Apply to the whole document (else the caret's section).
34:    pub whole: bool,
35:}
36:
37:impl NoteForm {
38:    /// The options in effect at the caret.
39:    pub fn read(app: &mut WordApp) -> NoteForm {
40:        let v = app.session.run("references.noteOptions", &json!({})).unwrap_or_default();
41:        let s = |kind: &str, k: &str, d: &str| v.get(kind).and_then(|o| o.get(k)).and_then(Value::as_str).unwrap_or(d).to_string();
42:        let n = |kind: &str| v.get(kind).and_then(|o| o.get("numStart")).and_then(Value::as_u64).unwrap_or(1).clamp(1, 32_767) as u32;
43:        NoteForm {
44:            endnote: false,
45:            pos: [s("footnote", "pos", "pageBottom"), s("endnote", "pos", "docEnd")],
46:            fmt: [s("footnote", "numFmt", "decimal"), s("endnote", "numFmt", "lowerRoman")],
47:            start: [n("footnote"), n("endnote")],
48:            restart: [s("footnote", "numRestart", "continuous"), s("endnote", "numRestart", "continuous")],
49:            mark: String::new(),
50:            whole: true,
51:        }
52:    }
53:
54:    /// `references.noteOptions` parameters for the chosen kind.
55:    pub fn params(&self) -> Value {
56:        let k = usize::from(self.endnote);
57:        let get = |a: &[String; 2]| a.get(k).cloned().unwrap_or_default();
58:        json!({
59:            "kind": if self.endnote { "endnote" } else { "footnote" },
60:            "pos": get(&self.pos),
61:            "numFmt": get(&self.fmt),
62:            "numStart": self.start.get(k).copied().unwrap_or(1),
63:            "numRestart": get(&self.restart),
64:            "scope": if self.whole { "document" } else { "section" },
65:        })
66:    }
67:}
68:
69:/// A choice from `options` ((value, label)) in a drop-down; `tr` translates the labels.
70:fn choice(ui: &mut Ui, id: &str, value: &mut String, options: &[(&str, &str)], tr: bool) {
71:    let show = |l: &str| if tr { tl!(l).to_string() } else { l.to_string() };
72:    let label = options.iter().find(|(v, _)| *v == value.as_str()).map(|(_, l)| show(l)).unwrap_or_default();
73:    egui::ComboBox::from_id_salt(id).selected_text(label).width(170.0).show_ui(ui, |ui| {
74:        for (v, l) in options {
75:            ui.selectable_value(value, v.to_string(), show(l));
76:        }
77:    });
78:}
79:
80:/// Footnote and Endnote. Returns true to close.
81:pub fn note_options(app: &mut WordApp, ui: &mut Ui, f: &mut NoteForm) -> bool {
82:    let heading = |ui: &mut Ui, s: &str| {
83:        ui.add_space(4.0);
84:        ui.label(egui::RichText::new(tl!(s)).font(semibold(12.5)));
85:    };
86:    heading(ui, "Location");
87:    let mut convert = None;
88:    egui::Grid::new("notes_location").num_columns(2).spacing(vec2(10.0, 6.0)).show(ui, |ui| {
89:        ui.radio_value(&mut f.endnote, false, tl!("Footnotes"));
90:        ui.add_enabled_ui(!f.endnote, |ui| {
91:            choice(ui, "notes_fpos", &mut f.pos[0], &[("pageBottom", "Bottom of Page"), ("beneathText", "Below text")], true);
92:        });
93:        ui.end_row();
94:        ui.radio_value(&mut f.endnote, true, tl!("Endnotes"));
95:        ui.add_enabled_ui(f.endnote, |ui| {
96:            choice(ui, "notes_epos", &mut f.pos[1], &[("sectEnd", "End of section"), ("docEnd", "End of document")], true);
97:        });
98:        ui.end_row();
99:        ui.label("");
100:        ui.menu_button(format!("{}…", tl!("Convert")), |ui| {
101:            for (to, l) in [("endnote", "Footnotes to endnotes"), ("footnote", "Endnotes to footnotes"), ("swap", "Swap footnotes and endnotes")] {
102:                if ui.button(tl!(l)).clicked() {
103:                    convert = Some(to);
104:                    ui.close();
105:                }
106:            }
107:        });
108:        ui.end_row();
109:    });
110:    if let Some(to) = convert
111:        && let Err(e) = app.run("references.convertNotes", json!({ "to": to }))
112:    {
113:        app.status(e);
114:    }
115:    heading(ui, "Format");
116:    let k = usize::from(f.endnote);
117:    egui::Grid::new("notes_format").num_columns(2).spacing(vec2(10.0, 6.0)).show(ui, |ui| {
118:        ui.label(tl!("Number format"));
119:        if let Some(v) = f.fmt.get_mut(k) {
120:            choice(ui, "notes_fmt", v, &FORMATS, false);
121:        }
122:        ui.end_row();
123:        ui.label(tl!("Custom mark:"));
124:        ui.add(egui::TextEdit::singleline(&mut f.mark).desired_width(60.0).char_limit(10));
125:        ui.end_row();
126:        ui.label(tl!("Start at:"));
127:        if let Some(v) = f.start.get_mut(k) {
128:            ui.add(egui::DragValue::new(v).range(1..=32_767).speed(0.2));
129:        }
130:        ui.end_row();
131:        ui.label(tl!("Numbering"));
132:        if let Some(v) = f.restart.get_mut(k) {
133:            let each_page: &[(&str, &str)] = if f.endnote { &[] } else { &[("eachPage", "Restart Each Page")] };
134:            let options: Vec<(&str, &str)> =
135:                [("continuous", "Continuous numbering"), ("eachSect", "Restart Each Section")].into_iter().chain(each_page.iter().copied()).collect();
136:            choice(ui, "notes_restart", v, &options, true);
137:        }
138:        ui.end_row();
139:        ui.label(tl!("Apply to:"));
140:        let mut scope = if f.whole { "document" } else { "section" }.to_string();
141:        choice(ui, "notes_scope", &mut scope, &[("document", "Whole document"), ("section", "This section")], true);
142:        f.whole = scope == "document";
143:        ui.end_row();
144:    });

