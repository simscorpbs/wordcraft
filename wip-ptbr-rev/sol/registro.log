136:pub struct LineNumbersForm {
137:    pub on: bool,
138:    pub start: u32,
139:    /// From text: automatic, or `distance`.
140:    pub auto_distance: bool,
141:    pub distance: f32,
142:    pub count_by: u32,
143:    /// `restartPage`, `restartSection` or `continuous`.
144:    pub restart: String,
145:}
146:
147:impl LineNumbersForm {
148:    pub fn read(app: &WordApp) -> LineNumbersForm {
149:        let sp = wordcraft_engine::cmd::page::sect(&app.session);
150:        let l = sp.line_numbers.clone();
151:        let cur = l.clone().unwrap_or_default();
152:        LineNumbersForm {
153:            on: l.is_some(),
154:            start: cur.start.max(1),
155:            auto_distance: cur.distance <= 0.0,
156:            distance: if cur.distance > 0.0 { cur.distance / unit().pt_per_unit() } else { 0.25 * 72.0 / unit().pt_per_unit() },
157:            count_by: cur.count_by.max(1),
158:            restart: match cur.restart {
159:                LineNumberRestart::Page => "restartPage",
160:                LineNumberRestart::Section => "restartSection",
161:                LineNumberRestart::Continuous => "continuous",
162:            }
163:            .into(),
164:        }
165:    }
166:
167:    /// `layout.lineNumbers` parameters.
168:    pub fn params(&self) -> Value {
169:        if !self.on {
170:            return json!({"value": "none"});
171:        }
172:        let distance = if self.auto_distance { 0.0 } else { (self.distance * unit().pt_per_unit()).max(0.0) };
173:        json!({"value": self.restart, "start": self.start, "countBy": self.count_by, "distance": distance})
174:    }
175:}
176:
177:fn line_numbers_ui(app: &mut WordApp, ui: &mut Ui, f: &mut LineNumbersForm) -> bool {
178:    ui.checkbox(&mut f.on, tl!("Add line numbering"));
179:    ui.add_enabled_ui(f.on, |ui| {
180:        egui::Grid::new("lnum").num_columns(2).spacing(vec2(10.0, 6.0)).show(ui, |ui| {
181:            ui.label(tl!("Start at:"));
182:            ui.add(egui::DragValue::new(&mut f.start).range(1..=32_767));
183:            ui.end_row();
184:            ui.label(tl!("From text:"));
185:            ui.horizontal(|ui| {
186:                ui.checkbox(&mut f.auto_distance, tl!("Auto"));
187:                ui.add_enabled(
188:                    !f.auto_distance,
189:                    egui::DragValue::new(&mut f.distance).speed(0.01).range(0.0..=22.0 * 72.0 / unit().pt_per_unit()).measure(unit()).max_decimals(2),
190:                );
191:            });
192:            ui.end_row();
193:            ui.label(tl!("Count by:"));
194:            ui.add(egui::DragValue::new(&mut f.count_by).range(1..=100));
195:            ui.end_row();
196:        });
197:        heading(ui, "Numbering:");
198:        for (v, l) in [("restartPage", "Restart Each Page"), ("restartSection", "Restart Each Section"), ("continuous", "Continuous")] {
199:            ui.radio_value(&mut f.restart, v.to_string(), tl!(l));
200:        }
201:    });
202:    let (ok, cancel) = buttons(ui, "OK", true);
203:    if ok {
204:        return run(app, "layout.lineNumbers", f.params());
205:    }

