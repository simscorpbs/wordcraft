1188                 mi(ui, app, label, "draw.addPen", json!({"kind": kind.name(), "color": cur.color.hex(), "width": cur.width}));
1189             }
1190         });
1191         stack(ui, |ui| {
1192             let sw = Some(crate::theme::c32(set.color));
1193             split(ui, app, "fontcolor", "Color", pen_command(tool), json!({}), false, sw, |ui, app| {
1194                 let theme = app.session.doc.settings.theme_colors.clone();
