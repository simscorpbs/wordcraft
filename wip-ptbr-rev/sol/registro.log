235:            v.ascending = !v.ascending;
236:        }
237:        ui.separator();
238:        if ui.selectable_label(!v.table, tl!("Grab bag")).clicked() {
239:            v.table = false;
240:        }
241:        if ui.selectable_label(v.table, tl!("Table")).clicked() {
242:            v.table = true;
243:        }
244:    });
245:    let list = sorted(CONTRIBUTORS, v.names, v.key, v.ascending);
246:    let summary = crate::i18n::fmt(
247:        tl!("{contributors} contributors · {commits} commits"),
248:        &[("contributors", &list.len().to_string()), ("commits", &group(TOTAL_COMMITS))],
249:    );
250:    ui.label(RichText::new(summary).small().weak());
251:    ui.separator();
252:    egui::ScrollArea::both().auto_shrink([false, true]).max_height(360.0).show(ui, |ui| {
253:        if list.is_empty() {
254:            ui.label(tl!("No contributor data was built into this copy."));
255:        } else if v.table {
256:            table(ui, &list, &mut v);
257:        } else {
258:            ui.horizontal_wrapped(|ui| {
259:                for (i, c) in list.iter().enumerate() {
260:                    if i > 0 {
261:                        ui.label(RichText::new("·").weak());
262:                    }
263:                    ui.hyperlink_to(c.name(v.names), format!("https://github.com/{}", c.login)).on_hover_text(c.summary());
264:                }
265:            });
266:        }
267:    });
268:    ui.data_mut(|d| d.insert_temp(id, v));
269:}
