1283 /// The Design tab's style set gallery in a box of its own, sized from its thumbnails and clipped
1284 /// to it, with a gap on each side: the Colors and Fonts column can't be drawn over, or cut by,
1285 /// the thumbnails (#638). Returns the box and the space the thumbnails used.
1286 fn style_set_box(app: &mut WordApp, ui: &mut Ui) -> (Rect, Rect) {
1287     ui.add_space(4.0);
1288     let (gallery, _) = ui.allocate_exact_size(vec2(crate::previews::STYLE_SET_GALLERY_W, CONTENT_H), Sense::hover());
1289     let mut gui = ui.new_child(egui::UiBuilder::new().max_rect(gallery).layout(egui::Layout::left_to_right(egui::Align::Min)));
1290     gui.set_clip_rect(gallery.intersect(ui.clip_rect()));
1291     gui.spacing_mut().item_spacing = vec2(1.0, 1.0);
1292     crate::previews::style_set_gallery(app, &mut gui);
1293     ui.add_space(8.0);
1294     (gallery, gui.min_rect())
1295 }
