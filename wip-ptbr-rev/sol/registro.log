base=Path('.')
source={int((a:=l.split('\\t',3))[0]):a for l in (base/'trecho.tsv').read_text(encoding='utf-8').splitlines()}
rows=[x.split('\\t') for x in (base/'propostas.tsv').read_text(encoding='utf-8').splitlines()]
out={int(r[0]):r for r in rows}
# Visible command, menu, dialog, and group names that follow the project's Word title case rule.
nums='1038 1039 1042 1043 1044 1045 1046 1047 1048 1049 1050 1051 1053 1054 1055 1056 1057 1060 1063 1064 1078 1085 1086 1087 1088 1095 1096 1114 1115 1116 1125 1155 1156 1157 1178 1185 1186 1191 1194 1199 1224 1230 1231 1259 1271 1272 1273 1313 1315 1316 1317 1318 1319 1331 1332 1333 1351 1357 1423 1424 1425 1426 1427 1428 1432 1433 1434 1435 1436 1437 1438 1439 1440 1441 1448 1449 1472 1473 1485 1517 1538 1573 1574 1575 1608 1620 1621 1622 1623 1624 1625 1626 1627 1629 1630 1631 1632 1633 1634 1650 1651 1654 1655 1658 1659 1685 1686 1687 1688 1690 1691 1696 1699 1727 1748 1750 1751 1752 1772 1787 1788 1789 1791 1792 1794 1797 1828 1829 1832 1833 1834 1835 1836 1837 1838 1839 1840 1841 1842 1843 1846 1848 1855 1862 1872 1874 1878 1905 1906 1909 1910 1992 1993 1997 1998 2000 2001 2003 2004 2005 2056 2063 2064 2082 2119 2120 2126 2155 2159 2173 2194 2198 2199'.split()
# Words that remain lower-case in the project's title case.
stop={'a','à','ao','aos','as','da','das','de','do','dos','e','em','entre','na','nas','no','nos','o','os','para','por','sem','sob','sobre','um','uma','uns','umas','com','ou','se','até','após','antes','como','pelo','pela','pelos','pelas','mais','menos','que'}
def title(pt):
    # Handle the catalog's literal escapes and final ellipses without changing them.
    tokens=re.split(r'(\\\\n|\\s+|[-/])', pt)
    out=[]
    for tok in tokens:
        if not tok or tok.isspace() or tok in ('\\\\n','-','/'):
            out.append(tok); continue
        trail=''
        while tok and tok[-1] in '…:,.?"'!)%'"':
            trail=tok[-1]+trail; tok=tok[:-1]
        if not tok:
            out.append(trail); continue
        if tok.startswith('{') or tok.upper()==tok or any(c.isdigit() for c in tok):
            out.append(tok+trail); continue
        if tok.lower() in stop and out:
            out.append(tok.lower()+trail)
        else:
            out.append(tok[:1].upper()+tok[1:]+trail)
    return ''.join(out)
for sn in nums:
    n=int(sn)
    if n not in source: raise SystemExit(f'linha ausente {n}')
    if n in out: continue
    _,ctx,en,cur=source[n]
    prop=title(cur)
    # The ellipsis is attached to the previous word and must keep the exact source spelling.
    if n==1156: prop='Ignorar Registro se…'
    if n==1157: prop='Ignorar Registro se'
    if prop==cur: continue
    out[n]=[str(n),ctx,en,cur,prop,'maiuscula','É um nome de recurso exibido em comando, menu ou diálogo.']
base.joinpath('propostas.tsv').write_text('\\n'.join('\\t'.join(out[n]) for n in sorted(out))+'\\n',encoding='utf-8')
print('propostas',len(out),'adicionadas',len(out)-len(rows))
