67:/// The pages to describe: those meeting `view`, and one either side.
68:pub fn page_window(rects: &[Rect], view: Rect) -> Option<(usize, usize)> {
69:    let first = rects.iter().position(|r| r.intersects(view))?;
70:    let last = rects.iter().rposition(|r| r.intersects(view)).unwrap_or(first);
71:    Some((first.saturating_sub(1), (last + 2).min(rects.len())))
72:}
