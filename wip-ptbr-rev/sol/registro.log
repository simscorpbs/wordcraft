16:/// What each structure button shows.
17:pub(crate) fn button_picture(id: &str) -> &'static str {
18:    match id {
19:        "fraction" => "x/y",
20:        "script" => "e^x",
21:        "radical" => "√(n&x)",
22:        "integral" => "∫_(−x)^x",
23:        "largeOperator" => "∑_(i=0)^n",
24:        "bracket" => "{()}",
25:        "function" => "sin⁡θ",
26:        "accent" => "ä",
27:        "limitLog" => "lim┬(n→∞)",
28:        "operator" => "≜",
29:        "matrix" => "[■(1&0@0&1)]",
30:        _ => "x",
31:    }
