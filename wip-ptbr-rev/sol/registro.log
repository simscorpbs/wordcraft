1240:fn field_options(ui: &mut Ui, f: &mut FieldForm, t: &Tokens) {
1241:    match field_kind(&f.name) {
1242:        FieldKind::Date => {
1243:            ui.label(tl!("Date formats:"));
1244:            ui.add(egui::TextEdit::singleline(&mut f.date_format).desired_width(f32::INFINITY));
1245:            egui::Frame::new().stroke(Stroke::new(1.0, t.border)).inner_margin(2.0).show(ui, |ui| {
1246:                egui::ScrollArea::vertical().id_salt("field_dates").max_height(170.0).auto_shrink([false, false]).show(ui, |ui| {
1247:                    for pic in DATE_FORMATS {
1248:                        let sample = wordcraft_engine::cmd::insert::format_date(pic);
1249:                        if ui.selectable_label(f.date_format == *pic, sample).on_hover_text(*pic).clicked() {
1250:                            f.date_format = (*pic).to_string();
1251:                        }
