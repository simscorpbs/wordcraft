153:    let w = (ui.ctx().fonts_mut(|f| f.layout_no_wrap(label.to_string(), regular(11.5), t.text).size().x) + 22.0).max(48.0);
154:    let (r, _) = ui.allocate_exact_size(vec2(w, CONTENT_H), Sense::hover());
155:    let top = Rect::from_min_max(r.min, pos2(r.max.x, r.min.y + BIG_LABEL_Y - 2.0));
156:    let bottom = Rect::from_min_max(pos2(r.min.x, r.min.y + BIG_LABEL_Y - 2.0), r.max);
157:    let rt = ui.interact(top, ui.id().with("eq_insert_top"), Sense::click());
158:    let rb = ui.interact(bottom, ui.id().with("eq_insert_bottom"), Sense::click());
159:    for (rr, resp) in [(top, &rt), (bottom, &rb)] {
160:        if resp.hovered() {
161:            ui.painter().rect_filled(rr, 4.0, t.hover);
162:        }
163:    }
164:    crate::icons::paint(
165:        ui.painter(),
166:        Rect::from_center_size(pos2(r.center().x, r.min.y + BIG_ICON_Y), vec2(32.0, 32.0)),
167:        "equation",
168:        t.icon,
169:        t.accent,
170:    );
171:    crate::widgets::label_line(ui, r.center().x, r.min.y + BIG_LABEL_Y, label, regular(11.5), t.text, true);
172:    if rt.on_hover_text(tl!("Insert a new equation (Alt+=)")).clicked() {
173:        let _ = app.run("insert.equation", json!({}));
174:        app.canvas.want_focus = true;
175:    }
176:    egui::Popup::menu(&rb).show(|ui| builtin_menu(ui, app));
177:}
