75:/// One gallery tile: the template rendered, its name as a tooltip.
76:fn tile(ui: &mut Ui, app: &mut WordApp, tpl: &Template, size: egui::Vec2) -> bool {
77:    let t = Tokens::get(ui.ctx());
78:    let (r, resp) = ui.allocate_exact_size(size, Sense::click());
79:    ui.painter().rect_filled(r, 2.0, t.input);
80:    if resp.hovered() {
81:        ui.painter().rect_stroke(r, 2.0, Stroke::new(1.5, t.accent), egui::StrokeKind::Inside);
82:    }
83:    let pt = if size.x > 120.0 { 13.0 } else { 14.0 };
84:    paint_math(app, ui, r.shrink(2.0), &format!("tpl:{}", tpl.id), tpl.linear, Some(tpl.nodes()), true, pt);
85:    resp.on_hover_text(tl!(tpl.label)).clicked()
86:}
