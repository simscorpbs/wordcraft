--- /dev/null
+++ b/final_review.py
@@ -0,0 +1,28 @@
+from pathlib import Path
+import json
+import re
+
+BASE = Path(__file__).resolve().parent
+ROOT = Path('C:/Users/Brenno/wordcraft/crates')
+ROWS = [line.split('\t') for line in (BASE / 'trecho.tsv').read_text(encoding='utf-8').splitlines()]
+FILES = [(p, p.read_text(encoding='utf-8')) for p in ROOT.rglob('*.rs')]
+
+def decode(s):
+    return re.sub(r'\\([nt\\])', lambda m: {'n':'\n','t':'\t','\\':'\\'}[m[1]], s)
+
+def contexts(a, b):
+    for n, ctx, en, pt in ROWS:
+        if not a <= int(n) <= b:
+            continue
+        literal = json.dumps(decode(en), ensure_ascii=False)
+        hits = []
+        for path, content in FILES:
+            for i, line in enumerate(content.splitlines(), 1):
+                if literal in line:
+                    hits.append(f'{path.relative_to(ROOT)}:{i} {line.strip()}')
+        print(f'{n} | {en} | {pt}')
+        print('\n'.join(hits[:3]))
+
+if __name__ == '__main__':
+    import sys
+    contexts(int(sys.argv[1]), int(sys.argv[2]))

