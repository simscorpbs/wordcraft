34:/// A rendered equation drawn into `r` (centred), or its linear text while it renders.
35:fn paint_math(app: &mut WordApp, ui: &Ui, r: Rect, key: &str, linear: &str, nodes: Option<wordcraft_doc::math::Arg>, display: bool, pt: f32) {
36:    let nodes = nodes.unwrap_or_else(|| parse_linear(linear));
37:    match crate::previews::math_texture(app, ui.ctx(), key, &nodes, display, pt, r.size()) {
38:        Some((tex, uv)) => {
39:            ui.painter().image(tex, r, uv, Tokens::get(ui.ctx()).text);
40:        }
41:        None => {
42:            let t = Tokens::get(ui.ctx());
43:            ui.painter().text(r.center(), Align2::CENTER_CENTER, linear, regular(11.0), t.text_dim);
44:        }
45:    }
46:}
