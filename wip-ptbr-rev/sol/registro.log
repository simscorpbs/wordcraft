59:#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
60:pub enum SortKey {
61:    Name,
62:    Prs,
63:    Commits,
64:    LinesAdded,
65:    LinesDeleted,
66:    LinesDelta,
67:    BinaryAdded,
68:    BinaryDeleted,
69:    #[default]
70:    FirstCommit,
71:    LastCommit,
72:}
73:
74:impl SortKey {
75:    pub const ALL: [SortKey; 10] = [
76:        SortKey::Name,
77:        SortKey::Prs,
78:        SortKey::Commits,
79:        SortKey::LinesAdded,
80:        SortKey::LinesDeleted,
81:        SortKey::LinesDelta,
82:        SortKey::BinaryAdded,
83:        SortKey::BinaryDeleted,
84:        SortKey::FirstCommit,
85:        SortKey::LastCommit,
86:    ];
87:
88:    /// Menu label and table header.
89:    pub fn label(self) -> (&'static str, &'static str) {
90:        match self {
91:            SortKey::Name => ("Name (A–Z)", "Name"),
92:            SortKey::Prs => ("Merged PRs", "PRs"),
93:            SortKey::Commits => ("Commits", "Commits"),
94:            SortKey::LinesAdded => ("Lines added", "+LOC"),
95:            SortKey::LinesDeleted => ("Lines deleted", "−LOC"),
96:            SortKey::LinesDelta => ("Line delta", "ΔLOC"),
97:            SortKey::BinaryAdded => ("Binary assets added", "+Bin"),
98:            SortKey::BinaryDeleted => ("Binary assets removed", "−Bin"),
99:            SortKey::FirstCommit => ("First commit", "First"),
100:            SortKey::LastCommit => ("Last commit", "Last"),
101:        }
102:    }
103:
104:    /// Names and dates read naturally oldest/A first; counts read biggest first.
105:    pub fn default_ascending(self) -> bool {
106:        matches!(self, SortKey::Name | SortKey::FirstCommit | SortKey::LastCommit)
107:    }
108:}
109:
110:impl Contributor {
111:    pub fn name(&self, mode: NameMode) -> String {
112:        let chosen = match mode {
113:            NameMode::Username => None,
114:            NameMode::DisplayName => self.display_name,
115:            NameMode::RealName => self.real_name,
116:        };
117:        chosen.map_or_else(|| format!("@{}", self.login), str::to_string)
118:    }
119:
120:    pub fn lines_delta(&self) -> i128 {
121:        i128::from(self.lines_added) - i128::from(self.lines_deleted)
122:    }
123:
124:    /// One line with everything we know, for tooltips.
125:    pub fn summary(&self) -> String {
126:        format!(
127:            "@{}: {} PRs, {} commits, +{} / −{} lines (Δ {}), +{} / −{} binary assets, {} – {}",
128:            self.login,
129:            self.prs,
130:            self.commits,
131:            group(self.lines_added),
132:            group(self.lines_deleted),
133:            signed(self.lines_delta()),
134:            self.binary_added,
135:            self.binary_deleted,
136:            day(self.first_commit),
137:            day(self.last_commit),
138:        )
139:    }
140:}
141:
142:/// Alphabetical key: case-insensitive, ignoring the `@` of usernames.
143:fn name_key(name: &str) -> String {
144:    name.trim_start_matches('@').to_lowercase()
145:}
146:
147:fn compare(a: &Contributor, b: &Contributor, mode: NameMode, key: SortKey) -> Ordering {
148:    match key {
149:        SortKey::Name => name_key(&a.name(mode)).cmp(&name_key(&b.name(mode))),
150:        SortKey::Prs => a.prs.cmp(&b.prs),
151:        SortKey::Commits => a.commits.cmp(&b.commits),
152:        SortKey::LinesAdded => a.lines_added.cmp(&b.lines_added),
153:        SortKey::LinesDeleted => a.lines_deleted.cmp(&b.lines_deleted),
154:        SortKey::LinesDelta => a.lines_delta().cmp(&b.lines_delta()),
155:        SortKey::BinaryAdded => a.binary_added.cmp(&b.binary_added),
156:        SortKey::BinaryDeleted => a.binary_deleted.cmp(&b.binary_deleted),
157:        // A PR-only contributor (no commit date) sorts after everyone with a date.
158:        SortKey::FirstCommit => dated(a.first_commit).cmp(&dated(b.first_commit)),
159:        SortKey::LastCommit => dated(a.last_commit).cmp(&dated(b.last_commit)),
160:    }
161:}
162:
163:fn dated(d: &str) -> (bool, &str) {
164:    (d.is_empty(), d)
165:}
166:
167:/// Contributors in display order. Ties fall back to the name (A–Z) so the order is stable.
168:pub fn sorted(list: &[Contributor], mode: NameMode, key: SortKey, ascending: bool) -> Vec<&Contributor> {
169:    let mut v: Vec<&Contributor> = list.iter().collect();
170:    v.sort_by(|a, b| {
171:        let o = compare(a, b, mode, key);
172:        let o = if ascending { o } else { o.reverse() };
173:        o.then_with(|| compare(a, b, mode, SortKey::Name)).then_with(|| a.login.cmp(b.login))
174:    });
175:    v
176:}
177:
178:fn group(n: u64) -> String {
179:    let s = n.to_string();
180:    let mut out = String::with_capacity(s.len() + s.len() / 3);
181:    for (i, ch) in s.chars().enumerate() {
182:        if i > 0 && (s.len() - i).is_multiple_of(3) {
183:            out.push(',');
184:        }
185:        out.push(ch);
186:    }
187:    out
188:}
189:
190:fn signed(n: i128) -> String {
191:    let g = group(u64::try_from(n.unsigned_abs()).unwrap_or(u64::MAX));
192:    if n < 0 { format!("−{g}") } else { format!("+{g}") }
193:}
194:
195:fn day(iso: &str) -> &str {
196:    if iso.is_empty() { "—" } else { iso.get(..10).unwrap_or(iso) }
197:}
