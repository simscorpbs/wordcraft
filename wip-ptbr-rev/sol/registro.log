2794:            let _ = app.run("equation.structure", json!({"action": action, "level": level}));
2795:            app.canvas.want_focus = true;
2796:            ui.close();
2797:        }
2798:    }
2799:    if last_level.is_some() {
2800:        ui.separator();
2801:    }
2802:    let display = app.session.run("equation.get", &json!({})).ok().and_then(|v| v.get("display").and_then(|d| d.as_bool())).unwrap_or(false);
2803:    let items: [(&str, &str, serde_json::Value); 5] = [
2804:        (if display { "Change to Inline" } else { "Change to Display" }, "equation.display", json!({"value": !display})),
2805:        ("Professional", "equation.convert", json!({"to": "professional"})),
2806:        ("Linear", "equation.convert", json!({"to": "linear"})),
2807:        ("Equation Number", "equation.number", json!({})),
2808:        ("Close Equation", "equation.exit", json!({})),
2809:    ];
2810:    for (label, id, params) in items {
2811:        if ui.button(tl!(label)).clicked() {
2812:            let _ = app.run(id, params);
2813:            app.canvas.want_focus = true;
2814:            ui.close();
2815:        }
2816:    }
2817:}
