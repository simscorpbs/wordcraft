if missing:
    raise SystemExit(f'linhas ausentes: {missing}')

out = []
for n in sorted(changes):
    ctx, en, cur = rows[n]
    prop, cat, reason = changes[n]
    if prop == cur:
        raise SystemExit(f'proposta igual à atual na linha {n}')
    out.append('\\t'.join([str(n), ctx, en, cur, prop, cat, reason]))
(base / 'propostas.tsv').write_text('\\n'.join(out) + '\\n', encoding='utf-8')
print(f'entradas lidas: {len(rows)}')
print(f'propostas: {len(out)}')
