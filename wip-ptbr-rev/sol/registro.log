from pathlib import Path
import re
root=Path('C:/Users/Brenno/wordcraft/crates')
rows=[]
for line in Path('trecho.tsv').read_text(encoding='utf-8').splitlines():
    n,ctx,en,pt=line.split('\\t'); rows.append((int(n),en,pt))
# exact i18n key or literal snippets; print matches only for selected ranges
for n,en,pt in rows:
    if n not in set(range(1038,1081)) and n not in set(range(1085,1139)) and n not in set(range(1197,1235)) and n not in set(range(1260,1311)) and n not in set(range(1445,1526)) and n not in set(range(1527,1579)) and n not in set(range(1593,1643)) and n not in set(range(1696,1737)) and n not in set(range(1762,1772)) and n not in set(range(1787,1827)) and n not in set(range(1827,1852)) and n not in set(range(1890,1958)) and n not in set(range(1961,1994)) and n not in set(range(2030,2117)) and n not in set(range(2158,2183)) and n not in set(range(2191,2206)) and n not in set(range(2220,2248)):
        continue
    # search translated from key (escaped newlines as literal backslash-n in source maybe)
    needle=en
    # rust source contains escaped \\n for strings
    needle_lit=needle.replace('\\\\','\\\\\\\\').replace('\"','\\\\\"')
    ms=[]
    for fp in root.rglob('*'):
        if fp.suffix not in ('.rs','.ron','.json','.toml'): continue
        try: txt=fp.read_text(encoding='utf-8')
        except: continue
        if needle in txt or needle_lit in txt:
            for i,ll in enumerate(txt.splitlines(),1):
                if needle in ll or needle_lit in ll:
                    ms.append(f'{fp.relative_to(root)}:{i}:{ll.strip()[:180]}')
    if ms:
        print(f'### {n} {en} => {pt}')
        print('\\n'.join(ms[:4]))
