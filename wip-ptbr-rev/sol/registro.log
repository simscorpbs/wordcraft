119 /// The ready-made equations (Insert › Equation and Equation › Equation).
120 pub fn builtin_menu(ui: &mut Ui, app: &mut WordApp) {
121     egui::ScrollArea::vertical().max_height(560.0).show(ui, |ui| {
122         ui.set_width(360.0);
123         section_heading(ui, "Built-In");
124         for (id, label, lin) in BUILT_INS {
125             let t = Tokens::get(ui.ctx());
126             ui.label(egui::RichText::new(tl!(label)).font(semibold(11.5)).color(t.text));
127             let (r, resp) = ui.allocate_exact_size(vec2(350.0, 64.0), Sense::click());
128             ui.painter().rect_filled(r, 2.0, t.input);
129             if resp.hovered() {
130                 ui.painter().rect_stroke(r, 2.0, Stroke::new(1.5, t.accent), egui::StrokeKind::Inside);
131             }
132             paint_math(app, ui, r.shrink(2.0), &format!("builtin:{id}"), lin, None, true, 11.0);
133             if resp.clicked() {
134                 let _ = app.run("insert.equation", json!({"builtin": id}));
135                 app.canvas.want_focus = true;
136                 ui.close();
137             }
138             ui.add_space(4.0);
139         }
140     });
141     ui.separator();
142     if ui.button(tl!("Insert New Equation")).clicked() {
143         let _ = app.run("insert.equation", json!({}));
144         app.canvas.want_focus = true;
145         ui.close();
146     }
147 }
