166 /// A row in the ribbon tree: the item, its indent level, its text, and (tabs) whether it shows.
167 struct Row {
168     item: TreeItem,
169     depth: u8,
170     text: String,
171     shown: Option<bool>,
172 }
173 
174 fn tree_rows(app: &WordApp) -> Vec<Row> {
175     let custom = tl!("(Custom)");
176     let mut rows = Vec::new();
177     for t in app.session.ribbon.tabs().iter() {
178         let text = if t.custom { format!("{} {custom}", t.name) } else { tl!(&t.name).to_string() };
179         rows.push(Row { item: TreeItem { tab: t.name.clone(), group: None, command: None }, depth: 0, text, shown: Some(!t.hidden) });
180         for g in &t.groups {
181             let item = TreeItem { tab: t.name.clone(), group: Some(g.name.clone()), command: None };
182             rows.push(Row { item, depth: 1, text: format!("{} {custom}", g.name), shown: None });
183             for id in &g.commands {
184                 let item = TreeItem { tab: t.name.clone(), group: Some(g.name.clone()), command: Some(id.clone()) };
185                 rows.push(Row { item, depth: 2, text: label_of(app, id), shown: None });
186             }
187         }
188     }
189     rows
190 }

